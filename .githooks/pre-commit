#!/bin/sh
# Guards against a session/tool using a guessed placeholder email that turns out to belong to
# someone else's real GitHub account, silently listing them as a contributor.
#
# Enable once per clone with:  git config core.hooksPath .githooks
# (or run: sh scripts/setup-git-identity.sh, which does that plus sets the identity itself)

ALLOWED_EMAIL="robinsinghrajawat@gmail.com"

author_email=$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')

if [ "$author_email" != "$ALLOWED_EMAIL" ]; then
  echo "✖ Commit blocked: author email is '$author_email', expected '$ALLOWED_EMAIL'."
  echo "  Fix with:"
  echo "    git config user.name \"robinrajawat\""
  echo "    git config user.email \"$ALLOWED_EMAIL\""
  exit 1
fi

# Guards against a real class of bug this app is structurally exposed to: a stray literal
# "<Title>" (or similar) landing somewhere it shouldn't gets parsed as a real <title> tag (a
# RAWTEXT element, same category as <script>), silently truncating/corrupting the main app
# script. See scripts/validate_html_structure.py for details.
if git diff --cached --name-only | grep -qx "public/index.html"; then
  if command -v python3 >/dev/null 2>&1 && python3 -c "import html5lib" >/dev/null 2>&1; then
    if ! python3 scripts/validate_html_structure.py; then
      echo "✖ Commit blocked: public/index.html failed HTML structure validation (see above)."
      exit 1
    fi
  else
    echo "⚠ Skipping HTML structure validation: html5lib not installed."
    echo "  Install with: pip install html5lib --break-system-packages"
  fi
fi

exit 0
