rules_version = '2';

// Firestore Security Rules for cricket-scorer.
//
// This file is not auto-deployed — paste it into Firebase Console → Firestore Database → Rules
// → Publish. Keeping it in the repo is so the actual access-control model has a diff history,
// instead of living only as tribal knowledge in the console.
//
// ---- The trust model in one paragraph ----
// This app has three tiers of data, each with a different capability:
//   1. /users/{uid}/...        — private to one signed-in Google account.
//   2. /sharedMatches/{code}   — a match code is a bearer capability for FULL scoring access.
//                                 Anyone who has the code (signed in or not) can read AND write it.
//   3. /liveViews/{code}       — a view code is a bearer capability for READ-ONLY access. A
//                                 DIFFERENT collection from #2, keyed by a DIFFERENT random code,
//                                 so a view code can never be used to gain scoring access no
//                                 matter what a viewer does with it — there is no document at
//                                 that code inside /sharedMatches for it to match.
// Clubs add a fourth tier: shared-but-not-public team rosters and tournaments, gated by Google
// account membership rather than a bearer code, because unlike a single match you actually want
// to know (and be able to revoke) who's in a club.
// Federations add a fifth, much thinner tier on top of clubs: a club can opt into a federation
// (e.g. "DCF") the same way a person joins a club, but a federation grants no membership, matches,
// or roster access of its own.
//
// ---- The permission model in one paragraph ----
// Clubs and federations each have exactly one privileged tier: "owner", which covers both the
// original creator (ownerUid on a club, createdBy on a federation) and anyone granted
// co-ownership (coOwnerUids on both). Owner and co-owner have IDENTICAL rights — there is no
// separate "admin" tier anymore. Only an owner/co-owner can rename, edit the description, invite
// people, manage teams/tournaments, remove members, or manage federation affiliation. Plain
// members (memberUids on a club) can be picked into rosters and read what they're a member of,
// but cannot write to any of it. Every invite in the app — becoming a member, becoming a
// co-owner, or a club affiliating with a federation — is addressed to one specific email address
// and can only be redeemed by someone signed in as that exact email (request.auth.token.email).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Personal account data — matches, teams, profile, house rules.
    // Only the signed-in owner can ever read or write their own subtree.
    // ---------------------------------------------------------------------
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------------
    // Full-access co-scoring. Knowledge of the 8-character code IS the credential — this is
    // intentional (it's how a teammate resumes scoring on another phone with no account needed)
    // and is unchanged from before. What changed is that this code is no longer also accepted as
    // a "read-only" link — see /liveViews below.
    //
    // `list` is explicitly denied and `get` is the only read path: `allow read: if true` would
    // grant BOTH, and a bare `.collection("sharedMatches").get()` with no filter would then dump
    // every shared match ever created — full rosters, scores, everything packMatchForFirestore
    // writes — to anyone on the internet, code or no code, since firebaseConfig is necessarily
    // public in a client-only app. A code is meant to be a capability you must already KNOW, not
    // one more document in an enumerable collection. See /tournamentMatches below for how the one
    // legitimate need to query this collection by tournamentId is served without that query ever
    // touching sharedMatches directly.
    // ---------------------------------------------------------------------
    match /sharedMatches/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Read-only live-follow mirror. Same open-by-code trust model as sharedMatches, but it is a
    // SEPARATE collection so a view code and a score code are never interchangeable. The app
    // only ever writes here from the match owner's client (see saveMatch/liveViews mirror write
    // in index.html) and only ever reads here from FollowScreen, which has no scoring controls.
    //
    // Same get-only reasoning as /sharedMatches above — `list` stays denied so this collection
    // can't be dumped wholesale either.
    // ---------------------------------------------------------------------
    match /liveViews/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Public "Live now" home-feed mirror, and the app-wide match search's data source — every
    // match currently being scored, plus one still marked complete within the last
    // RECENT_MATCH_RETENTION_DAYS, gets mirrored here (see saveMatch in index.html), whether or
    // not its scorer has ever generated a share/view code, so it can be found without needing a
    // link at all — and can still be found for a few days after it ends, not just while it's live.
    // Same packMatchForFirestore shape and same open get/write trust model as /liveViews just
    // above — this is a pure display cache, structurally separate from /sharedMatches and
    // /users/{uid}/matches, so nothing written or read here can ever grant or reveal write access
    // to the real match, only the same read-only score data /liveViews already exposes to anyone
    // holding a code. The one deliberate difference from /liveViews: `list: true` — being listable
    // is this collection's entire purpose. A match marked private (derived from its Organizer --
    // personal is always private, club/federation always public -- or inherited from a private
    // tournament for one started within it) is never written here at all, live or after
    // completion — opted out, not merely hidden. Docs are deleted on match deletion (same file)
    // and carry an expiresAt TTL — short while in progress (an abandoned-mid-game safety net),
    // RECENT_MATCH_RETENTION_DAYS once complete (the real retention window).
    // ---------------------------------------------------------------------
    match /liveMatches/{matchId} {
      allow get: if true;
      allow list: if true;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Read-only tournament share snapshot. Same open-by-code, owner-writes/anyone-reads trust
    // model as /liveViews — a SEPARATE collection again so a tournament share code can never be
    // confused with a match code or view code from a different feature. Historically a pure
    // point-in-time snapshot (the owner's client wrote it once, only when they opened the share
    // panel and hit refresh); it's now also kept live by refreshTournamentStandingsLive in
    // index.html, which any client — owner or a guest scoring via a match's own share code —
    // triggers after saving a completed match tagged with a tournamentId, using ONLY the public
    // data below (/tournamentMatches/{tournamentId} + its /entries). The manual "refresh" flow
    // (shareTournament) still exists too, both for minting the first share code and because it's
    // the only path that can see a signed-in owner's own privately-scored matches (see the next
    // block's comment) — so standings here are best-effort live, not guaranteed live.
    //
    // Same get-only reasoning as /sharedMatches above — `list` stays denied.
    // ---------------------------------------------------------------------
    match /tournamentViews/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Public mirror of just enough of a tournament's config — teams, and fixtures reduced to
    // {id, teamA, teamB, date, stage, matchId} — for computeStandings to run against it with no
    // other read. Written/kept in sync by shareTournament (index.html) whenever the owner shares
    // or refreshes; deleted when sharing stops or the tournament itself is deleted
    // (stopSharingTournament / deleteTournamentShareData). This is what lets
    // refreshTournamentStandingsLive recompute /tournamentViews/{code} from a client that has no
    // access to the real tournament doc at all (a guest scoring one fixture via a match share
    // code has never seen /clubs/{clubId}/tournaments/{id}, which is club-membership-gated).
    // `shareCode` and `private` ride along so a live-refresh attempt can cheaply no-op for a
    // tournament that was never shared or has since been marked private, without an extra read.
    //
    // Same get-only reasoning as /tournamentViews above — `list` stays denied (there is no
    // legitimate reason to enumerate every tournament's config doc; a client always arrives here
    // already knowing a specific tournamentId, from a match it just saved). Carries its own
    // `expiresAt`, kept in lockstep with /tournamentViews/{code}'s (see shareTournament and
    // refreshTournamentStandingsLive in index.html) so this doc can never outlive the share
    // snapshot it exists to keep updated — see "Running your own copy" in README.md for the TTL
    // policy this depends on. Only the config doc at this exact path carries a TTL; the /entries
    // subcollection just below is a different collection and untouched by it.
    // ---------------------------------------------------------------------
    match /tournamentMatches/{tournamentId} {
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Pointer index for "find every shared match tagged with tournament X" (loadTournamentMatches
    // in index.html), so standings/stats computation never has to run an unscoped query against
    // /sharedMatches itself. Each entry is just {tournamentId, matchId, shareCode} — enough to
    // resolve to a `get` on the real match doc, nothing else — never scores, names, or anything
    // else. Reading it USED to require being signed in; opened to public get/list so
    // refreshTournamentStandingsLive (see /tournamentViews above) can enumerate a tournament's
    // matches from a guest client with no account at all, the same client that just wrote one of
    // these entries via its own match's shareCode moments earlier. A query here is still
    // inherently scoped to one tournament's subcollection — there is no way to query "every entry
    // across every tournament" without a collection-group rule, which this file deliberately
    // never grants — so this stays "you already know this one tournamentId" rather than "you can
    // dump the whole app's match history in one query."
    // Writes are unauthenticated on purpose, same as /sharedMatches itself: a guest scoring a
    // match via a code with no account still needs to be able to register it here if that match
    // carries a tournamentId.
    // ---------------------------------------------------------------------
    match /tournamentMatches/{tournamentId}/entries/{entryId} {
      allow get, list: if true;
      allow create, update: if request.resource.data.tournamentId == tournamentId
        && request.resource.data.matchId is string
        && request.resource.data.shareCode is string;
      allow delete: if true;
    }

    // ---------------------------------------------------------------------
    // Public "Live tournaments" home-feed mirror — same shape/trust model/reasoning as /liveMatches
    // above, one tier down: every currently-shared, non-private tournament, so the Home screen's
    // "Live tournaments" strip can be found without a link, same as "Live now" already does for
    // matches. Written by shareTournament (manual refresh) and refreshTournamentStandingsLive (live
    // auto-refresh) in index.html whenever a non-private tournament's standings are (re)published;
    // deleted by stopSharingTournament/deleteTournamentShareData. Deliberately just display fields
    // (name, shareCode, team count) rather than the full standings table — tapping a card opens
    // FollowTournamentScreen by shareCode, which fetches /tournamentViews/{code} itself; duplicating
    // that here would be one more place for the two to drift apart, for no reader who needs it.
    //
    // `list: true` — being listable is this collection's entire purpose, same as /liveMatches.
    // ---------------------------------------------------------------------
    match /liveTournaments/{tournamentId} {
      allow get: if true;
      allow list: if true;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Clubs — shared team rosters gated by Google-account membership, not a bearer code.
    // Owner and co-owner are functionally identical throughout — every helper below treats them
    // as one tier by checking both ownerUid and coOwnerUids.
    // ---------------------------------------------------------------------
    function isClubOwner(club) {
      return request.auth.uid == club.ownerUid || request.auth.uid in club.get('coOwnerUids', []);
    }

    // App-wide admin check -- hardcoded email kept as a bootstrap fallback (so this account can
    // never get locked out), ORed with a data-driven /admins/{uid} doc so additional admins can be
    // added/removed without a code + rules redeploy. Originally named isFeedbackAdminAuth when it
    // only gated /feedback triage; renamed once it also started gating beta tester management
    // below -- "app admin" is what it actually checks. See index.html's isFeedbackAdmin/
    // checkIsCollectionAdmin for the client-side mirror of this same check.
    function isAppAdminAuth() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'robinsinghrajawat@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ---------------------------------------------------------------------
    // Beta tester flag. Deliberately its OWN top-level collection rather than
    // living under /users/{uid} — the rule above grants the signed-in owner
    // full write access to their own subtree, which would let anyone flip
    // their own beta flag on from the browser console. Read-only to the
    // owner themselves (their own status); an app admin can additionally
    // read, list, and write any entry -- granting/revoking beta access from
    // the in-app Beta Testers admin screen instead of only via the Firebase
    // Console/an admin script (both of which still work too, unchanged).
    // ---------------------------------------------------------------------
    match /betaTesters/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAppAdminAuth());
      allow list: if isAppAdminAuth();
      allow write: if isAppAdminAuth();
    }

    // ---------------------------------------------------------------------
    // Beta access requests -- the companion to /betaTesters above. The client has no way to look
    // up a UID from an email (that's an Admin-SDK-only operation; this app has no server), so
    // there's no way to build a normal "type an email, grant beta access" admin control. This is
    // the workaround: a signed-in person requests for THEMSELVES (their own uid/email are already
    // known and provable via their own auth session, so no lookup is needed), and the admin
    // reviews/approves real pending requests instead of guessing at UIDs. Doc id is the
    // requester's own uid, so create/update rules can enforce "only your own request, and it must
    // actually claim your own uid" without any extra bookkeeping.
    // ---------------------------------------------------------------------
    match /betaRequests/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAppAdminAuth());
      allow list: if isAppAdminAuth();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;
      allow delete: if isAppAdminAuth();
    }

    match /clubs/{clubId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.get('coOwnerUids', []) == [];

      allow update: if request.auth != null && (
        // (A) Owner/co-owner editing general club data (name, description, federationIds, and so
        // on). Membership, ownership, and the co-owner list itself must not change via this
        // branch — that's what (B)/(C)/(D) are for. Uses get(field, default) throughout because
        // clubs created before this field existed have no coOwnerUids field at all — a bare
        // resource.data.coOwnerUids on one of those errors out the whole check rather than
        // reading as empty.
        (
          isClubOwner(resource.data) &&
          request.resource.data.memberUids == resource.data.memberUids &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.get('coOwnerUids', []) == resource.data.get('coOwnerUids', [])
        )
        ||
        // (C) Self-leave. Anyone but the owner can remove only themselves — also drops
        // themselves from coOwnerUids, if they were one.
        (
          request.auth.uid in resource.data.memberUids &&
          request.auth.uid != resource.data.ownerUid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid]) &&
          request.resource.data.get('coOwnerUids', []) == resource.data.get('coOwnerUids', []).removeAll([request.auth.uid])
        )
        ||
        // (D) Owner/co-owner removing someone else (member or co-owner), or pruning the list —
        // ownership itself (ownerUid) can't change here (that would need an explicit transfer
        // flow, deliberately not built). coOwnerUids must stay a subset of whatever memberUids
        // ends up as, so a removed member can't linger as a co-owner.
        (
          isClubOwner(resource.data) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.memberUids.hasOnly(resource.data.memberUids) &&
          request.resource.data.get('coOwnerUids', []).hasOnly(request.resource.data.memberUids)
        )
        ||
        // (E) Any current member correcting their OWN display name in memberNames — e.g. when it
        // was stored blank/generic because their Google account had no display name set at the
        // time they joined, and they've since signed in with a proper name or the client falls
        // back to their email instead. Scoped to exactly one key so a member can never touch
        // anyone else's entry, membership, or anything else on the doc.
        (
          request.auth.uid in resource.data.memberUids &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberNames']) &&
          request.resource.data.memberNames.diff(resource.data.get('memberNames', {})).affectedKeys().hasOnly([request.auth.uid])
        )
      );

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // Owner/co-owner only — plain members can read a club's teams (to pick them for scoring) but
    // never write to them.
    match /clubs/{clubId}/teams/{teamId} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberUids;
      allow write: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(clubId)).data);
    }

    match /clubs/{clubId}/tournaments/{tournamentId} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberUids;
      allow write: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(clubId)).data);
    }

    // ---------------------------------------------------------------------
    // Federations — a light umbrella tag (e.g. "DCF") that clubs opt into via an email-locked
    // invite, same bearer-capability-plus-email pattern as a club invite. Same owner/co-owner
    // tier as clubs — createdBy is the permanent primary owner, coOwnerUids holds anyone else
    // granted identical rights via email invite.
    // ---------------------------------------------------------------------
    function isFederationOwner(federation) {
      return request.auth.uid == federation.createdBy || request.auth.uid in federation.get('coOwnerUids', []);
    }
    // Helpers for keeping federations/{id}.affiliatedClubIds in sync with which clubs currently
    // list this federation in their OWN federationIds (the source of truth). This denormalized
    // list exists for exactly one reason: it's what makes "delete an EMPTY federation" (see the
    // delete rule below) checkable at all — a security rule can never run a query across the whole
    // clubs collection to ask "does any club still reference me?", so the only way to know is to
    // maintain the answer as data, updated by whichever club owner is actually joining/leaving
    // (see joinFederationWithCode/leaveFederation/respondFederationRequest/
    // completeAcceptedFederationRequest/kickClubFromFederation/deleteClub in index.html — every
    // site that touches a club's federationIds also makes the matching companion write here).
    // Each helper is scoped to touching exactly one id, on exactly this field, by exactly the
    // owner/co-owner of the one club being added or removed — nothing else about the federation
    // doc may change in the same write, and the caller can never claim to add/remove someone
    // else's club.
    function canSyncFederationClubJoin(federationId, oldIds, newIds) {
      let added = newIds.removeAll(oldIds);
      return added.size() == 1
        && oldIds.hasOnly(newIds)
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(added[0])).data)
        && federationId in get(/databases/$(database)/documents/clubs/$(added[0])).data.get('federationIds', []);
    }
    function canSyncFederationClubLeave(oldIds, newIds) {
      let removed = oldIds.removeAll(newIds);
      return removed.size() == 1
        && newIds.hasOnly(oldIds)
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(removed[0])).data);
    }

    match /federations/{federationId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if request.auth != null && (
        // (A) Owner/co-owner editing federation data (rename, description, kickedClubIds,
        // affiliatedClubIds — e.g. kickClubFromFederation removing an entry on their own doc).
        // coOwnerUids and createdBy must not change via this branch — that's what (C)/(F) below
        // are for. get(field, default) handles federations from before these fields existed.
        (
          isFederationOwner(resource.data) &&
          request.resource.data.get('coOwnerUids', []) == resource.data.get('coOwnerUids', []) &&
          request.resource.data.createdBy == resource.data.createdBy
        )
        ||
        // (C) Removing one or more co-owners — coOwnerUids may only SHRINK (become a subset of
        // what it was), never grow or add anyone new (that's what (F) below is for). Covers both
        // the owner/a co-owner removing a DIFFERENT co-owner (see removeFederationCoOwner in
        // index.html — previously impossible under this rule, since (A) locks coOwnerUids
        // entirely), and a co-owner removing THEMSELVES (mirrors clubs' self-leave branch; also
        // what account deletion relies on to clean up a departing co-owner's federations, see
        // deleteUserAccount). createdBy can never be removed this way — deliberately: there is no
        // ownership-transfer flow, so the original creator is a permanent, unremovable anchor
        // (though the federation ITSELF can now be deleted once empty — see below).
        (
          isFederationOwner(resource.data) &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.get('coOwnerUids', []).hasOnly(resource.data.get('coOwnerUids', []))
        )
        ||
        // (D) A club owner/co-owner syncing THEIR OWN club's id into affiliatedClubIds right
        // after affiliating. Requires that club to already list this federation in its own
        // federationIds, so this can only mirror a join that genuinely just happened elsewhere,
        // never manufacture one.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['affiliatedClubIds']) &&
          canSyncFederationClubJoin(federationId, resource.data.get('affiliatedClubIds', []), request.resource.data.affiliatedClubIds)
        )
        ||
        // (E) A club owner/co-owner syncing THEIR OWN club's id back OUT of affiliatedClubIds —
        // self-leaving, or the last step of deleting their own club while it's still affiliated.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['affiliatedClubIds']) &&
          canSyncFederationClubLeave(resource.data.get('affiliatedClubIds', []), request.resource.data.affiliatedClubIds)
        )
      );

      // A federation can be deleted once it's EMPTY — no club currently affiliated — by its
      // owner/co-owner. Safe specifically because affiliatedClubIds (kept in sync by (D)/(E)
      // above and by branch (A) for kicks) is the authoritative "is anything still relying on
      // this?" signal; there is deliberately still no ownership-transfer flow, so only the
      // permanent owner tier can do this, same as every other federation-level action.
      allow delete: if request.auth != null
        && isFederationOwner(resource.data)
        && resource.data.get('affiliatedClubIds', []).size() == 0;
    }

    // A federation-hosted tournament — read is open to any signed-in user, the SAME trust tier as
    // the federation document itself just above: a federation was already designed as a
    // semi-public directory rather than a private space like a club, so this doesn't introduce any
    // new exposure, it just extends the same openness to cover the one thing a federation would
    // naturally want to host. The alternative — gating reads to "member of any affiliated club" —
    // would mean looping every affiliated club's membership inside the rule itself, bounded by
    // Firestore's per-request lookup limit; a federation with a lot of affiliated clubs could start
    // failing unpredictably purely from having grown. Write stays locked to the owner tier, same as
    // every other federation-level action (creating/editing fixtures, deleting the tournament, etc.
    // are all the same "owner or co-owner" check as clubs/{clubId}/tournaments/{tournamentId}
    // above uses for club-hosted tournaments).
    match /federations/{federationId}/tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && isFederationOwner(get(/databases/$(database)/documents/federations/$(federationId)).data);
    }

    // ---------------------------------------------------------------------
    // Public user directory — lets a signed-in person be findable by name (see
    // setMyProfileVisibility in index.html), so a club/federation owner inviting a co-owner or
    // member isn't limited to "already know their exact email" the way every invite flow otherwise
    // is. Published automatically once per sign-in now (see cricketScorer.js's own mount effect,
    // and AccountScreen no longer carries a toggle for it) — this is a name-lookup convenience for
    // an invite the sender could otherwise send by typing the exact email address anyway, not a
    // data-access gate, so there's nothing this doc's mere existence unlocks: everything below
    // still pins every field to the caller's own verified identity, exactly as it did when
    // publishing was opt-in. A doc here is deleted only via an account being deleted outright (see
    // deleteUserAccount in index.html) — there is no client path back to unpublished for an
    // otherwise-active account any more.
    //
    // Unlike a club or federation, an account has no separate "owner" who could vouch for it, so
    // the create/update rule instead pins every field to the caller's own verified identity: name
    // is theirs to set freely (same as the profile display name elsewhere in the app), but email
    // must equal their own token email and photoURL must equal their own token's `picture` claim
    // exactly (or be absent/null) — can't spoof a photo. Nothing here can be used to impersonate or
    // misdirect an invite to someone else, since every field a searcher would act on is
    // independently derived from the searcher's own knowledge of the real person, not just trusted
    // from this doc blindly --
    // and the actual invite this feeds into still targets the plain `email` field either way,
    // identical to typing it in by hand.
    // ---------------------------------------------------------------------
    match /userDirectory/{uid} {
      allow get, list: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.get('photoURL', null) == request.auth.token.get('picture', null);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------------
    // Feedback & automatic error reports — a write-only mailbox. Anyone (signed in or not, since
    // an error can happen before sign-in and feedback shouldn't require an account) can file one;
    // NO client can ever read, list, update, or delete ANY of them, including their own — this is
    // deliberately one-directional, like dropping a letter in a mailbox slot. Robin reads these
    // directly in the Firebase Console (Console access isn't bound by these rules at all). Basic
    // shape validation only: a non-empty, size-capped message and a known kind, so this can't be
    // used to dump arbitrary large blobs.
    // ---------------------------------------------------------------------
    // Read/update are opened up to exactly one signed-in email (the app's owner) so feedback and
    // auto-captured error reports can be triaged in-app instead of only via the Firebase Console.
    // Everyone else keeps create-only, write-only access -- see the comment above submitFeedback
    // in index.html for why that stays the default (no way for a submitter, or anyone else, to
    // browse other people's reports). Update is limited to exactly the two admin-set fields so the
    // admin account can never alter what was actually reported.
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.kind in ['feedback', 'error']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 6000;
      allow read: if isAppAdminAuth();
      allow update: if isAppAdminAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolutionNote', 'priority']);
      allow delete: if isAppAdminAuth();
    }

    // ---------------------------------------------------------------------
    // Activity notifications — a durable, per-recipient record of a club/federation membership
    // event: someone joined, left, was removed, had their role changed, or responded to a
    // co-owner/member invite. This app has no server, no push, no email, so this collection IS the
    // notification system: written by the OTHER party's client at the moment of the real
    // membership-changing write, read by the recipient the next time they open their Inbox.
    //
    // Currently dormant: every one of notifyActivity's former call sites (respondCoOwnerInvite,
    // joinClubWithCode, leaveClub, removeClubMember, removeClubCoOwner, removeFederationCoOwner) was
    // club/federation-admin UI removed by docs/simplification-plan.md, so nothing writes here any
    // more. Kept deliberately (see that plan doc) as reusable infrastructure — InboxScreen and the
    // /activity collection itself stay in the codebase — for if/when team-sharing-with-another-
    // person ships and needs a notification mechanism again; its club/federation-shaped ownership
    // checks below would need rewriting for whatever that feature's real permission model turns
    // out to be, since there'd be no club/federation to check ownership against.
    //
    // `create` can't validate full narrative correctness (e.g. that "removed" actually happened) --
    // that would mean re-deriving what a Firestore rule fundamentally can't see, the OLD value of a
    // field that's already been overwritten by the companion write. What it CAN and does check: one
    // of the two parties (actorUid, who must be the caller — no writing on someone else's behalf —
    // or forUid, the recipient) must currently be verifiable owner-tier on the named club/
    // federation, so a stranger with no standing in that club/federation at all can't spam an
    // arbitrary uid. This single "one side is owner-tier" check covers every kind without a
    // per-kind branch: for joined/left the ACTOR is the one who joined/left (maybe just a plain
    // member) and the RECIPIENT is the owner being told about it; for removed/role_changed the
    // ACTOR is the owner who acted and the RECIPIENT is the affected person (maybe just a plain
    // member); for invite_response the ACTOR is whoever responded (not owner-tier if they declined,
    // or if they accepted a plain member-role invite) and the RECIPIENT is the invite's sender.
    // ---------------------------------------------------------------------
    function isClubOwnerTierUid(club, uid) {
      return uid == club.ownerUid || uid in club.get('coOwnerUids', []);
    }
    function isFederationOwnerTierUid(federation, uid) {
      return uid == federation.createdBy || uid in federation.get('coOwnerUids', []);
    }
    match /activity/{activityId} {
      allow get: if request.auth != null && resource.data.forUid == request.auth.uid;
      allow list: if request.auth != null && resource.data.forUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.forUid is string
        && request.resource.data.forUid != request.auth.uid
        && request.resource.data.scope in ['club', 'federation']
        && request.resource.data.kind in ['joined', 'left', 'removed', 'role_changed', 'invite_response']
        && request.resource.data.entityId is string
        && (
          (
            request.resource.data.scope == 'club' &&
            (
              isClubOwnerTierUid(get(/databases/$(database)/documents/clubs/$(request.resource.data.entityId)).data, request.auth.uid)
              || isClubOwnerTierUid(get(/databases/$(database)/documents/clubs/$(request.resource.data.entityId)).data, request.resource.data.forUid)
            )
          )
          ||
          (
            request.resource.data.scope == 'federation' &&
            (
              isFederationOwnerTierUid(get(/databases/$(database)/documents/federations/$(request.resource.data.entityId)).data, request.auth.uid)
              || isFederationOwnerTierUid(get(/databases/$(database)/documents/federations/$(request.resource.data.entityId)).data, request.resource.data.forUid)
            )
          )
        );

      // The recipient may only ever flip their own `read` flag -- nothing else about a
      // notification is theirs to change, and no one (including the actor who sent it) can ever
      // edit what it says after the fact.
      allow update: if request.auth != null && resource.data.forUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // The recipient can clear their own notification once they've seen it -- this is their own
      // copy of "you were told about X", not the historical record of X itself (that's the real
      // club/federation doc, or the coOwnerInvites doc, neither of which this touches), so deleting
      // it has no effect on anyone else or on what actually happened.
      allow delete: if request.auth != null && resource.data.forUid == request.auth.uid;
    }

    // Existence-only admin registry -- a doc at /admins/{uid} means that uid is an admin, checked
    // by isAppAdminAuth() above. A user may only read their OWN doc (existence, no field
    // values needed), never list the collection, so this can't be used to enumerate who else is
    // an admin. No client write path at all -- adding/removing an admin is a Firebase Console (or
    // Admin SDK) action, the same trust tier as reviewing /feedback itself in the console before
    // the in-app inbox existed.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }
  }
}
