rules_version = '2';

// Firestore Security Rules for cricket-scorer.
//
// This file is not auto-deployed — paste it into Firebase Console → Firestore Database → Rules
// → Publish. Keeping it in the repo is so the actual access-control model has a diff history,
// instead of living only as tribal knowledge in the console.
//
// ---- The trust model in one paragraph ----
// This app has three tiers of data, each with a different capability:
//   1. /users/{uid}/...        — private to one signed-in Google account.
//   2. /sharedMatches/{code}   — a match code is a bearer capability for FULL scoring access.
//                                 Anyone who has the code (signed in or not) can read AND write it.
//   3. /liveViews/{code}       — a view code is a bearer capability for READ-ONLY access. A
//                                 DIFFERENT collection from #2, keyed by a DIFFERENT random code,
//                                 so a view code can never be used to gain scoring access no
//                                 matter what a viewer does with it — there is no document at
//                                 that code inside /sharedMatches for it to match.
// Clubs add a fourth tier: shared-but-not-public team rosters and tournaments, gated by Google
// account membership rather than a bearer code, because unlike a single match you actually want
// to know (and be able to revoke) who's in a club.
// Federations add a fifth, much thinner tier on top of clubs: a club can opt into a federation
// (e.g. "DCF") the same way a person joins a club, but a federation grants no membership,
// matches, or roster access of its own — only a read-only name directory (federations/{id}/teams)
// that says "this club has a team called X", so a tournament organizer in one member club can
// pick another member club's team without ever seeing that club's private data.
// Players add a sixth tier, thinner still: a directory entry for one real person, keyed by email,
// that any club's owner/co-owner can publish (make public/borrowable) or a roster can simply
// reference by email without publishing anything at all. See the /players/{playerEmail} rule
// below for the full reasoning.
//
// ---- The permission model in one paragraph ----
// Clubs and federations each have exactly one privileged tier: "owner", which covers both the
// original creator (ownerUid on a club, createdBy on a federation) and anyone granted
// co-ownership (coOwnerUids on both). Owner and co-owner have IDENTICAL rights — there is no
// separate "admin" tier anymore. Only an owner/co-owner can rename, edit the description, invite
// people, manage teams/tournaments, remove members, or manage federation affiliation. Plain
// members (memberUids on a club) can be picked into rosters and read what they're a member of,
// but cannot write to any of it. Every invite in the app — becoming a member, becoming a
// co-owner, or a club affiliating with a federation — is addressed to one specific email address
// and can only be redeemed by someone signed in as that exact email (request.auth.token.email).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Personal account data — matches, teams, profile, house rules.
    // Only the signed-in owner can ever read or write their own subtree.
    // ---------------------------------------------------------------------
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------------
    // Full-access co-scoring. Knowledge of the 8-character code IS the credential — this is
    // intentional (it's how a teammate resumes scoring on another phone with no account needed)
    // and is unchanged from before. What changed is that this code is no longer also accepted as
    // a "read-only" link — see /liveViews below.
    //
    // `list` is explicitly denied and `get` is the only read path: `allow read: if true` would
    // grant BOTH, and a bare `.collection("sharedMatches").get()` with no filter would then dump
    // every shared match ever created — full rosters, scores, everything packMatchForFirestore
    // writes — to anyone on the internet, code or no code, since firebaseConfig is necessarily
    // public in a client-only app. A code is meant to be a capability you must already KNOW, not
    // one more document in an enumerable collection. See /tournamentMatches below for how the one
    // legitimate need to query this collection by tournamentId is served without that query ever
    // touching sharedMatches directly.
    // ---------------------------------------------------------------------
    match /sharedMatches/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Read-only live-follow mirror. Same open-by-code trust model as sharedMatches, but it is a
    // SEPARATE collection so a view code and a score code are never interchangeable. The app
    // only ever writes here from the match owner's client (see saveMatch/liveViews mirror write
    // in index.html) and only ever reads here from FollowScreen, which has no scoring controls.
    //
    // Same get-only reasoning as /sharedMatches above — `list` stays denied so this collection
    // can't be dumped wholesale either.
    // ---------------------------------------------------------------------
    match /liveViews/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Public "Live now" home-feed mirror, and the app-wide match search's data source — every
    // match currently being scored, plus one still marked complete within the last
    // RECENT_MATCH_RETENTION_DAYS, gets mirrored here (see saveMatch in index.html), whether or
    // not its scorer has ever generated a share/view code, so it can be found without needing a
    // link at all — and can still be found for a few days after it ends, not just while it's live.
    // Same packMatchForFirestore shape and same open get/write trust model as /liveViews just
    // above — this is a pure display cache, structurally separate from /sharedMatches and
    // /users/{uid}/matches, so nothing written or read here can ever grant or reveal write access
    // to the real match, only the same read-only score data /liveViews already exposes to anyone
    // holding a code. The one deliberate difference from /liveViews: `list: true` — being listable
    // is this collection's entire purpose. A match marked private (a per-match toggle, or
    // inherited by default from a private tournament) is never written here at all, live or after
    // completion — opted out, not merely hidden. Docs are deleted on match deletion (same file)
    // and carry an expiresAt TTL — short while in progress (an abandoned-mid-game safety net),
    // RECENT_MATCH_RETENTION_DAYS once complete (the real retention window).
    // ---------------------------------------------------------------------
    match /liveMatches/{matchId} {
      allow get: if true;
      allow list: if true;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Read-only tournament share snapshot. Same open-by-code, owner-writes/anyone-reads trust
    // model as /liveViews — a SEPARATE collection again so a tournament share code can never be
    // confused with a match code or view code from a different feature. Historically a pure
    // point-in-time snapshot (the owner's client wrote it once, only when they opened the share
    // panel and hit refresh); it's now also kept live by refreshTournamentStandingsLive in
    // index.html, which any client — owner or a guest scoring via a match's own share code —
    // triggers after saving a completed match tagged with a tournamentId, using ONLY the public
    // data below (/tournamentMatches/{tournamentId} + its /entries). The manual "refresh" flow
    // (shareTournament) still exists too, both for minting the first share code and because it's
    // the only path that can see a signed-in owner's own privately-scored matches (see the next
    // block's comment) — so standings here are best-effort live, not guaranteed live.
    //
    // Same get-only reasoning as /sharedMatches above — `list` stays denied.
    // ---------------------------------------------------------------------
    match /tournamentViews/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Public mirror of just enough of a tournament's config — teams, and fixtures reduced to
    // {id, teamA, teamB, date, stage, matchId} — for computeStandings to run against it with no
    // other read. Written/kept in sync by shareTournament (index.html) whenever the owner shares
    // or refreshes; deleted when sharing stops or the tournament itself is deleted
    // (stopSharingTournament / deleteTournamentShareData). This is what lets
    // refreshTournamentStandingsLive recompute /tournamentViews/{code} from a client that has no
    // access to the real tournament doc at all (a guest scoring one fixture via a match share
    // code has never seen /clubs/{clubId}/tournaments/{id}, which is club-membership-gated).
    // `shareCode` and `private` ride along so a live-refresh attempt can cheaply no-op for a
    // tournament that was never shared or has since been marked private, without an extra read.
    //
    // Same get-only reasoning as /tournamentViews above — `list` stays denied (there is no
    // legitimate reason to enumerate every tournament's config doc; a client always arrives here
    // already knowing a specific tournamentId, from a match it just saved). Carries its own
    // `expiresAt`, kept in lockstep with /tournamentViews/{code}'s (see shareTournament and
    // refreshTournamentStandingsLive in index.html) so this doc can never outlive the share
    // snapshot it exists to keep updated — see "Running your own copy" in README.md for the TTL
    // policy this depends on. Only the config doc at this exact path carries a TTL; the /entries
    // subcollection just below is a different collection and untouched by it.
    // ---------------------------------------------------------------------
    match /tournamentMatches/{tournamentId} {
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Pointer index for "find every shared match tagged with tournament X" (loadTournamentMatches
    // in index.html), so standings/stats computation never has to run an unscoped query against
    // /sharedMatches itself. Each entry is just {tournamentId, matchId, shareCode} — enough to
    // resolve to a `get` on the real match doc, nothing else — never scores, names, or anything
    // else. Reading it USED to require being signed in; opened to public get/list so
    // refreshTournamentStandingsLive (see /tournamentViews above) can enumerate a tournament's
    // matches from a guest client with no account at all, the same client that just wrote one of
    // these entries via its own match's shareCode moments earlier. A query here is still
    // inherently scoped to one tournament's subcollection — there is no way to query "every entry
    // across every tournament" without a collection-group rule, which this file deliberately
    // never grants — so this stays "you already know this one tournamentId" rather than "you can
    // dump the whole app's match history in one query."
    // Writes are unauthenticated on purpose, same as /sharedMatches itself: a guest scoring a
    // match via a code with no account still needs to be able to register it here if that match
    // carries a tournamentId.
    // ---------------------------------------------------------------------
    match /tournamentMatches/{tournamentId}/entries/{entryId} {
      allow get, list: if true;
      allow create, update: if request.resource.data.tournamentId == tournamentId
        && request.resource.data.matchId is string
        && request.resource.data.shareCode is string;
      allow delete: if true;
    }

    // ---------------------------------------------------------------------
    // Public "Live tournaments" home-feed mirror — same shape/trust model/reasoning as /liveMatches
    // above, one tier down: every currently-shared, non-private tournament, so the Home screen's
    // "Live tournaments" strip can be found without a link, same as "Live now" already does for
    // matches. Written by shareTournament (manual refresh) and refreshTournamentStandingsLive (live
    // auto-refresh) in index.html whenever a non-private tournament's standings are (re)published;
    // deleted by stopSharingTournament/deleteTournamentShareData. Deliberately just display fields
    // (name, shareCode, team count) rather than the full standings table — tapping a card opens
    // FollowTournamentScreen by shareCode, which fetches /tournamentViews/{code} itself; duplicating
    // that here would be one more place for the two to drift apart, for no reader who needs it.
    //
    // `list: true` — being listable is this collection's entire purpose, same as /liveMatches.
    // ---------------------------------------------------------------------
    match /liveTournaments/{tournamentId} {
      allow get: if true;
      allow list: if true;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Availability polls — same open-by-code, bearer-capability trust model as /sharedMatches:
    // a teammate responding needs no account, only the link (see createAvailabilityPoll/
    // submitPollResponse in index.html). What's different from /sharedMatches is WHO can create
    // one in the first place: that's restricted to the team's club owner/co-owner, checked here
    // by following clubId on the new doc back to the real club and reusing isClubOwner (defined
    // below, for the /clubs rules) — Firestore evaluates rules top-to-bottom in one file, but a
    // function can be called before its own match block appears textually, so this is fine.
    //
    // `list` stays denied for the same reason as /sharedMatches — a poll code is meant to be a
    // capability you already have, not one more document in an enumerable collection. Finding
    // "every poll for team X" is instead served by the separate, membership-gated pointer index
    // at /clubs/{clubId}/teams/{teamId}/polls/{code} below, same shape as /tournamentMatches
    // above serves the equivalent need for shared matches.
    //
    // Responding is scoped to touching ONLY the `responses` map — every other field on the poll
    // (question, fixtureDate, clubId, teamId, createdAt, createdByUid) must stay exactly as it
    // was. This does not stop one respondent from overwriting another's already-submitted answer
    // if they know the poll link, the same coarse "the link is the credential" trust boundary
    // /sharedMatches already accepts for something with far higher stakes (full scoring access).
    // ---------------------------------------------------------------------
    match /availabilityPolls/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data)
        && request.resource.data.responses == {};
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responses'])
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.question == resource.data.question
        && request.resource.data.fixtureDate == resource.data.fixtureDate
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data);
    }

    // ---------------------------------------------------------------------
    // Clubs — shared team rosters gated by Google-account membership, not a bearer code.
    // Owner and co-owner are functionally identical throughout — every helper below treats them
    // as one tier by checking both ownerUid and coOwnerUids.
    // ---------------------------------------------------------------------
    function isClubOwner(club) {
      return request.auth.uid == club.ownerUid || request.auth.uid in club.get('coOwnerUids', []);
    }

    // App-wide admin check -- hardcoded email kept as a bootstrap fallback (so this account can
    // never get locked out), ORed with a data-driven /admins/{uid} doc so additional admins can be
    // added/removed without a code + rules redeploy. Originally named isFeedbackAdminAuth when it
    // only gated /feedback triage; renamed once it also started gating beta tester management
    // below -- "app admin" is what it actually checks. See index.html's isFeedbackAdmin/
    // checkIsCollectionAdmin for the client-side mirror of this same check.
    function isAppAdminAuth() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'robinsinghrajawat@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ---------------------------------------------------------------------
    // Beta tester flag. Deliberately its OWN top-level collection rather than
    // living under /users/{uid} — the rule above grants the signed-in owner
    // full write access to their own subtree, which would let anyone flip
    // their own beta flag on from the browser console. Read-only to the
    // owner themselves (their own status); an app admin can additionally
    // read, list, and write any entry -- granting/revoking beta access from
    // the in-app Beta Testers admin screen instead of only via the Firebase
    // Console/an admin script (both of which still work too, unchanged).
    // ---------------------------------------------------------------------
    match /betaTesters/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAppAdminAuth());
      allow list: if isAppAdminAuth();
      allow write: if isAppAdminAuth();
    }

    // ---------------------------------------------------------------------
    // Beta access requests -- the companion to /betaTesters above. The client has no way to look
    // up a UID from an email (that's an Admin-SDK-only operation; this app has no server), so
    // there's no way to build a normal "type an email, grant beta access" admin control. This is
    // the workaround: a signed-in person requests for THEMSELVES (their own uid/email are already
    // known and provable via their own auth session, so no lookup is needed), and the admin
    // reviews/approves real pending requests instead of guessing at UIDs. Doc id is the
    // requester's own uid, so create/update rules can enforce "only your own request, and it must
    // actually claim your own uid" without any extra bookkeeping.
    // ---------------------------------------------------------------------
    match /betaRequests/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAppAdminAuth());
      allow list: if isAppAdminAuth();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;
      allow delete: if isAppAdminAuth();
    }

    match /clubs/{clubId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.get('coOwnerUids', []) == [];

      allow update: if request.auth != null && (
        // (A) Owner/co-owner editing general club data (name, description, federationIds, and so
        // on). Membership, ownership, and the co-owner list itself must not change via this
        // branch — that's what (B)/(C)/(D) are for. Uses get(field, default) throughout because
        // clubs created before this field existed have no coOwnerUids field at all — a bare
        // resource.data.coOwnerUids on one of those errors out the whole check rather than
        // reading as empty.
        (
          isClubOwner(resource.data) &&
          request.resource.data.memberUids == resource.data.memberUids &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.get('coOwnerUids', []) == resource.data.get('coOwnerUids', [])
        )
        ||
        // (B) Self-redeeming a club invite addressed to MY signed-in email — see
        // joinClubWithCode/inviteClubMemberByEmail/inviteClubCoOwnerByEmail in index.html. The
        // invite code names exactly this club, this exact email, and hasn't expired. Depending on
        // the code's own `role` field the redeemer lands in memberUids only, or in memberUids AND
        // coOwnerUids — nothing else about the doc may change in the same write. expiresAt is a
        // real Timestamp (see ttlTimestamp in index.html), compared directly against request.time
        // — also a Timestamp — rather than converting either side to millis.
        (
          !(request.auth.uid in resource.data.memberUids) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.name == resource.data.name &&
          'joinCodeUsed' in request.resource.data &&
          get(/databases/$(database)/documents/clubJoinCodes/$(request.resource.data.joinCodeUsed)).data.clubId == clubId &&
          get(/databases/$(database)/documents/clubJoinCodes/$(request.resource.data.joinCodeUsed)).data.expiresAt > request.time &&
          get(/databases/$(database)/documents/clubJoinCodes/$(request.resource.data.joinCodeUsed)).data.email == request.auth.token.email.lower() &&
          request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid]) &&
          (
            (
              get(/databases/$(database)/documents/clubJoinCodes/$(request.resource.data.joinCodeUsed)).data.role == "coOwner" &&
              request.resource.data.coOwnerUids == resource.data.get('coOwnerUids', []).concat([request.auth.uid])
            )
            ||
            (
              get(/databases/$(database)/documents/clubJoinCodes/$(request.resource.data.joinCodeUsed)).data.role != "coOwner" &&
              request.resource.data.get('coOwnerUids', []) == resource.data.get('coOwnerUids', [])
            )
          )
        )
        ||
        // (C) Self-leave. Anyone but the owner can remove only themselves — also drops
        // themselves from coOwnerUids, if they were one.
        (
          request.auth.uid in resource.data.memberUids &&
          request.auth.uid != resource.data.ownerUid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid]) &&
          request.resource.data.get('coOwnerUids', []) == resource.data.get('coOwnerUids', []).removeAll([request.auth.uid])
        )
        ||
        // (D) Owner/co-owner removing someone else (member or co-owner), or pruning the list —
        // ownership itself (ownerUid) can't change here (that would need an explicit transfer
        // flow, deliberately not built). coOwnerUids must stay a subset of whatever memberUids
        // ends up as, so a removed member can't linger as a co-owner.
        (
          isClubOwner(resource.data) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.memberUids.hasOnly(resource.data.memberUids) &&
          request.resource.data.get('coOwnerUids', []).hasOnly(request.resource.data.memberUids)
        )
        ||
        // (E) Any current member correcting their OWN display name in memberNames — e.g. when it
        // was stored blank/generic because their Google account had no display name set at the
        // time they joined, and they've since signed in with a proper name or the client falls
        // back to their email instead. Scoped to exactly one key so a member can never touch
        // anyone else's entry, membership, or anything else on the doc.
        (
          request.auth.uid in resource.data.memberUids &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberNames']) &&
          request.resource.data.memberNames.diff(resource.data.get('memberNames', {})).affectedKeys().hasOnly([request.auth.uid])
        )
        ||
        // (F) Self-redeeming a PENDING /coOwnerInvites doc addressed to MY signed-in email, role
        // "coOwner" (missing role on an old invite from before this field existed also counts as
        // "coOwner" — that was the only role that ever existed then) — the unified invite flow
        // (see inviteCoOwner/respondCoOwnerInvite in index.html and the /coOwnerInvites rules
        // below; replaces minting new coOwner-role /clubJoinCodes, though any already issued
        // before this shipped still redeem via branch (B) until they're used or expire). Adds me
        // to BOTH memberUids and coOwnerUids in one write — co-owner implies membership, so
        // coOwnerUids alone would leave me unable to even read the club (see the read rule above)
        // — while the actual /coOwnerInvites doc itself is flipped to "accepted" by a SEPARATE
        // write to that collection, governed by its own rules, not this one. Doesn't re-check the
        // invite's status here (unlike branch (B)'s code check) because the client deliberately
        // does this club write BEFORE that one, precisely so this get() still sees the invite as
        // it was minted — checking scope/entityId/email/expiry here is enough, since reusing an
        // already-accepted invite can only ever re-grant access to the same one email it was
        // already addressed to, never escalate to anyone else. See (G) below for role "member".
        (
          !(request.auth.uid in resource.data.memberUids) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.name == resource.data.name &&
          'coOwnerInviteAccepted' in request.resource.data &&
          get(/databases/$(database)/documents/coOwnerInvites/$(request.resource.data.coOwnerInviteAccepted)).data.scope == 'club' &&
          get(/databases/$(database)/documents/coOwnerInvites/$(request.resource.data.coOwnerInviteAccepted)).data.get('role', 'coOwner') == 'coOwner' &&
          get(/databases/$(database)/documents/coOwnerInvites/$(request.resource.data.coOwnerInviteAccepted)).data.entityId == clubId &&
          get(/databases/$(database)/documents/coOwnerInvites/$(request.resource.data.coOwnerInviteAccepted)).data.email == request.auth.token.email.lower() &&
          get(/databases/$(database)/documents/coOwnerInvites/$(request.resource.data.coOwnerInviteAccepted)).data.expiresAt > request.time &&
          request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid]) &&
          request.resource.data.coOwnerUids == resource.data.get('coOwnerUids', []).concat([request.auth.uid])
        )
        ||
        // (G) Same self-redeeming flow as (F), for role "member" — grants ONLY memberUids, never
        // coOwnerUids. This is the low-friction replacement for clubJoinCodes' role:"member" invite
        // (see the top of this file's permission-model paragraph): the owner just needs an email,
        // no code to copy/send, and it still requires the recipient to explicitly accept via their
        // own Inbox (see respondCoOwnerInvite in index.html) — deliberately kept as one invite
        // pattern for every role rather than adding a no-accept-needed path, even though a plain
        // member grants far less than a co-owner.
        (
          !(request.auth.uid in resource.data.memberUids) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.name == resource.data.name &&
          'coOwnerInviteAccepted' in request.resource.data &&
          get(/databases/$(database)/documents/coOwnerInvites/$(request.resource.data.coOwnerInviteAccepted)).data.scope == 'club' &&
          get(/databases/$(database)/documents/coOwnerInvites/$(request.resource.data.coOwnerInviteAccepted)).data.get('role', 'coOwner') == 'member' &&
          get(/databases/$(database)/documents/coOwnerInvites/$(request.resource.data.coOwnerInviteAccepted)).data.entityId == clubId &&
          get(/databases/$(database)/documents/coOwnerInvites/$(request.resource.data.coOwnerInviteAccepted)).data.email == request.auth.token.email.lower() &&
          get(/databases/$(database)/documents/coOwnerInvites/$(request.resource.data.coOwnerInviteAccepted)).data.expiresAt > request.time &&
          request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid]) &&
          request.resource.data.get('coOwnerUids', []) == resource.data.get('coOwnerUids', [])
        )
      );

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // Owner/co-owner only — plain members can read a club's teams (to pick them for scoring) but
    // never write to them.
    match /clubs/{clubId}/teams/{teamId} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberUids;
      allow write: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(clubId)).data);
    }

    // Pointer index for "every availability poll for this team" (loadTeamPolls in index.html) —
    // same shape and same reasoning as /tournamentMatches/{tournamentId}/entries above: the real
    // poll (question, fixtureDate, responses) lives in the open-by-code /availabilityPolls/{code}
    // collection, which can't be queried/listed; this lightweight pointer ({code, question,
    // fixtureDate, createdAt}, no responses) is what a captain's "past polls" list actually reads,
    // gated by ordinary club membership like the rest of a club's data rather than by a code.
    match /clubs/{clubId}/teams/{teamId}/polls/{code} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberUids;
      allow write: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(clubId)).data);
    }

    match /clubs/{clubId}/tournaments/{tournamentId} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberUids;
      allow write: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(clubId)).data);
    }

    // ---------------------------------------------------------------------
    // Players — a directory entry for a real person, keyed by their (lowercased) email so the
    // same person resolves to the same doc no matter which club adds them: e.g. two clubs each
    // adding "alex@x.com" to a roster share one Player, rather than becoming two unrelated
    // people. A roster entry with no email is just a plain name, exactly as before this
    // collection existed — nothing here is required.
    //
    // homeClubId is whichever club FIRST published this player (made them public/borrowable) and
    // is the only club whose owner/co-owner can edit or unpublish them; it's immutable afterward,
    // same reasoning as ownerUid on a club. linkedUid is set once, automatically, the moment
    // someone signs in with this exact email (see linkPlayerIfMatch in index.html) — it can only
    // ever move from unset to that one specific person, never reassigned or cleared via this rule.
    //
    // Reads are open to any signed-in user, not just the home club — needed for the cross-club
    // "browse public players" directory itself to work as a query rather than a per-doc lookup.
    // Same "found by design, small and listable" trust level as /clubDirectory and
    // /federationDirectory below: nothing sensitive lives on this doc beyond a name and an email,
    // and it's genuinely meant to be found by other clubs, unlike club/federation membership data
    // or a match/view code (which stay get-only precisely because they're NOT meant to be found —
    // see /sharedMatches above).
    // ---------------------------------------------------------------------
    match /players/{playerEmail} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;

      allow create: if request.auth != null
        && playerEmail == request.resource.data.email
        && request.resource.data.get('linkedUid', null) == null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(request.resource.data.homeClubId)).data);

      allow update: if request.auth != null && (
        // (A) Home club's owner/co-owner editing name/public. homeClubId, email, and linkedUid
        // must not change via this branch — homeClubId transfer isn't supported here (see (C)
        // below for the dedicated transfer path instead), and linkedUid is exclusively branch
        // (B)'s to set.
        (
          isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.homeClubId)).data) &&
          request.resource.data.homeClubId == resource.data.homeClubId &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.get('linkedUid', null) == resource.data.get('linkedUid', null)
        )
        ||
        // (B) Auto-link on sign-in: the signed-in person's own verified email exactly matches
        // this doc, nobody's linked to it yet, and the only fields changing are linkedUid (to
        // exactly this person's own uid) and, optionally, photoURL — see linkPlayerIfMatch in
        // index.html. photoURL must come verbatim from the auth token's own `picture` claim
        // (never an arbitrary client-supplied value), so this can only ever mirror the signed-in
        // person's own Google account picture, not attach an arbitrary image to someone else.
        (
          request.auth.token.email.lower() == resource.data.email &&
          resource.data.get('linkedUid', null) == null &&
          request.resource.data.linkedUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid', 'photoURL']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoURL']) ||
            request.resource.data.photoURL == request.auth.token.get('picture', null)
          )
        )
        ||
        // (C) Transfer to a different home club — authorized by the CURRENT home club's
        // owner/co-owner only (same authority deletePlayer already requires from them; handing
        // the player to a specific new club is strictly less drastic than the delete they're
        // already allowed to do unilaterally, so no separate consent from the destination club is
        // required here). homeClubId is the only field this branch may touch — everything else
        // (name/age/role/hands/email/linkedUid/public) carries over exactly as it was, unlike the
        // old delete-and-republish workaround this replaces, which lost that info. See
        // transferPlayerHomeClub in index.html.
        (
          isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.homeClubId)).data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['homeClubId']) &&
          request.resource.data.homeClubId != resource.data.homeClubId
        )
      );

      allow delete: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.homeClubId)).data);
    }

    // ---------------------------------------------------------------------
    // Club invite codes. A single collection covers both kinds of club invite — becoming a plain
    // member, or becoming a co-owner — distinguished by the code doc's own `role` field (checked
    // against the redeemer's signed-in email in the clubs/{clubId} update rule, branch B, not
    // here). A code is a single-purpose capability token: any signed-in user can look one up by
    // its exact ID (that's how redeeming resolves code → clubId), but only the club's
    // owner/co-owner can mint or revoke one.
    // ---------------------------------------------------------------------
    match /clubJoinCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.clubId is string
        && request.resource.data.email is string
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data);

      allow delete: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data);

      allow update: if false; // codes are immutable — rotate by delete + create instead
    }

    // ---------------------------------------------------------------------
    // Federations — a light umbrella tag (e.g. "DCF") that clubs opt into via an email-locked
    // invite, same bearer-capability-plus-email pattern as a club invite. Same owner/co-owner
    // tier as clubs — createdBy is the permanent primary owner, coOwnerUids holds anyone else
    // granted identical rights via email invite.
    // ---------------------------------------------------------------------
    function isFederationOwner(federation) {
      return request.auth.uid == federation.createdBy || request.auth.uid in federation.get('coOwnerUids', []);
    }
    // Helpers for keeping federations/{id}.affiliatedClubIds in sync with which clubs currently
    // list this federation in their OWN federationIds (the source of truth). This denormalized
    // list exists for exactly one reason: it's what makes "delete an EMPTY federation" (see the
    // delete rule below) checkable at all — a security rule can never run a query across the whole
    // clubs collection to ask "does any club still reference me?", so the only way to know is to
    // maintain the answer as data, updated by whichever club owner is actually joining/leaving
    // (see joinFederationWithCode/leaveFederation/respondFederationRequest/
    // completeAcceptedFederationRequest/kickClubFromFederation/deleteClub in index.html — every
    // site that touches a club's federationIds also makes the matching companion write here).
    // Each helper is scoped to touching exactly one id, on exactly this field, by exactly the
    // owner/co-owner of the one club being added or removed — nothing else about the federation
    // doc may change in the same write, and the caller can never claim to add/remove someone
    // else's club.
    function canSyncFederationClubJoin(federationId, oldIds, newIds) {
      let added = newIds.removeAll(oldIds);
      return added.size() == 1
        && oldIds.hasOnly(newIds)
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(added[0])).data)
        && federationId in get(/databases/$(database)/documents/clubs/$(added[0])).data.get('federationIds', []);
    }
    function canSyncFederationClubLeave(oldIds, newIds) {
      let removed = oldIds.removeAll(newIds);
      return removed.size() == 1
        && newIds.hasOnly(oldIds)
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(removed[0])).data);
    }

    match /federations/{federationId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if request.auth != null && (
        // (A) Owner/co-owner editing federation data (rename, description, kickedClubIds,
        // affiliatedClubIds — e.g. kickClubFromFederation removing an entry on their own doc).
        // coOwnerUids and createdBy must not change via this branch — that's what (C)/(F) below
        // are for. get(field, default) handles federations from before these fields existed.
        (
          isFederationOwner(resource.data) &&
          request.resource.data.get('coOwnerUids', []) == resource.data.get('coOwnerUids', []) &&
          request.resource.data.createdBy == resource.data.createdBy
        )
        ||
        // (C) Removing one or more co-owners — coOwnerUids may only SHRINK (become a subset of
        // what it was), never grow or add anyone new (that's what (F) below is for). Covers both
        // the owner/a co-owner removing a DIFFERENT co-owner (see removeFederationCoOwner in
        // index.html — previously impossible under this rule, since (A) locks coOwnerUids
        // entirely), and a co-owner removing THEMSELVES (mirrors clubs' self-leave branch; also
        // what account deletion relies on to clean up a departing co-owner's federations, see
        // deleteUserAccount). createdBy can never be removed this way — deliberately: there is no
        // ownership-transfer flow, so the original creator is a permanent, unremovable anchor
        // (though the federation ITSELF can now be deleted once empty — see below).
        (
          isFederationOwner(resource.data) &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.get('coOwnerUids', []).hasOnly(resource.data.get('coOwnerUids', []))
        )
        ||
        // (D) A club owner/co-owner syncing THEIR OWN club's id into affiliatedClubIds right
        // after affiliating. Requires that club to already list this federation in its own
        // federationIds, so this can only mirror a join that genuinely just happened elsewhere,
        // never manufacture one.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['affiliatedClubIds']) &&
          canSyncFederationClubJoin(federationId, resource.data.get('affiliatedClubIds', []), request.resource.data.affiliatedClubIds)
        )
        ||
        // (E) A club owner/co-owner syncing THEIR OWN club's id back OUT of affiliatedClubIds —
        // self-leaving, or the last step of deleting their own club while it's still affiliated.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['affiliatedClubIds']) &&
          canSyncFederationClubLeave(resource.data.get('affiliatedClubIds', []), request.resource.data.affiliatedClubIds)
        )
        ||
        // (F) Self-redeeming a PENDING /coOwnerInvites doc (scope 'federation') addressed to MY
        // signed-in email — the federation twin of the clubs/{clubId} branch (F) above; see its
        // comment for the full reasoning (same "check the invite as minted, not as it stands now"
        // ordering, same "replaces minting new invites, not existing ones" scope). A federation has
        // no membership tier of its own, so this only ever touches coOwnerUids.
        (
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.coOwnerUids == resource.data.get('coOwnerUids', []).concat([request.auth.uid]) &&
          'coOwnerInviteAccepted' in request.resource.data &&
          get(/databases/$(database)/documents/coOwnerInvites/$(request.resource.data.coOwnerInviteAccepted)).data.scope == 'federation' &&
          get(/databases/$(database)/documents/coOwnerInvites/$(request.resource.data.coOwnerInviteAccepted)).data.entityId == federationId &&
          get(/databases/$(database)/documents/coOwnerInvites/$(request.resource.data.coOwnerInviteAccepted)).data.email == request.auth.token.email.lower() &&
          get(/databases/$(database)/documents/coOwnerInvites/$(request.resource.data.coOwnerInviteAccepted)).data.expiresAt > request.time
        )
      );

      // A federation can be deleted once it's EMPTY — no club currently affiliated — by its
      // owner/co-owner. Safe specifically because affiliatedClubIds (kept in sync by (D)/(E)
      // above and by branch (A) for kicks) is the authoritative "is anything still relying on
      // this?" signal; there is deliberately still no ownership-transfer flow, so only the
      // permanent owner tier can do this, same as every other federation-level action.
      allow delete: if request.auth != null
        && isFederationOwner(resource.data)
        && resource.data.get('affiliatedClubIds', []).size() == 0;
    }

    // A federation-hosted tournament — read is open to any signed-in user, the SAME trust tier as
    // the federation document itself and its team directory just above (federations/{federationId},
    // federations/{federationId}/teams/{entryId}): a federation was already designed as a
    // semi-public directory rather than a private space like a club, so this doesn't introduce any
    // new exposure, it just extends the same openness to cover the one thing a federation would
    // naturally want to host. The alternative — gating reads to "member of any affiliated club" —
    // would mean looping every affiliated club's membership inside the rule itself, bounded by
    // Firestore's per-request lookup limit; a federation with a lot of affiliated clubs could start
    // failing unpredictably purely from having grown. Write stays locked to the owner tier, same as
    // every other federation-level action (creating/editing fixtures, deleting the tournament, etc.
    // are all the same "owner or co-owner" check as clubs/{clubId}/tournaments/{tournamentId}
    // above uses for club-hosted tournaments).
    match /federations/{federationId}/tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && isFederationOwner(get(/databases/$(database)/documents/federations/$(federationId)).data);
    }

    // A club-affiliation invite, addressed to one email. Only that signed-in email may even read
    // the code (so a stranger can't discover which federation it points to); redeeming it is a
    // write to the CLUB's own federationIds, enforced by the clubs/{clubId} update rule's general
    // branch (A), which already requires the caller to be that club's owner/co-owner.
    match /federationJoinCodes/{code} {
      allow get: if request.auth != null
        && resource.data.email == request.auth.token.email.lower();
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.federationId is string
        && request.resource.data.email is string
        && isFederationOwner(get(/databases/$(database)/documents/federations/$(request.resource.data.federationId)).data);

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // Unified invites, addressed to one email — one collection covering every role/scope
    // combination that ever needed an email-locked invite: club co-owner, club plain member, and
    // federation co-owner (a federation has no plain-member tier of its own, so `role` there is
    // always "coOwner"). Started out narrower — see the BUG FIX block below for the get()-in-list
    // saga this collection went through while it only covered co-owner invites — then absorbed
    // club member invites too, retiring clubJoinCodes' role:"member" create path the same way it
    // already retired federationCoOwnerInviteCodes outright (once every invite minted under a
    // retired path was confirmed redeemed or expired, its rules were removed rather than kept
    // alive indefinitely; see docs/co-owner-invites-plan.md for the original migration this
    // mirrors). Unlike a bearer code, this is a real record-per-invite the recipient's OWN client
    // can query by their own email (`where("email","==",myEmail)`), so it shows up in their Inbox
    // on its own — no code to mint, copy, or send out-of-band, for ANY role.
    //
    // clubJoinCodes' rules stay alive above (unchanged) — read/redeem-only now, purely so any
    // member-role code already minted before this collection absorbed member invites still works
    // until it's used or expires; nothing mints a new one any more (see inviteCoOwner's comment in
    // index.html). federationCoOwnerInviteCodes, the OTHER old collection, served only co-owner
    // invites, so once every one ever minted was confirmed redeemed or expired, its rules (and the
    // federations/{id} update rule's matching redemption branch) were removed outright above
    // rather than kept alive.
    // ---------------------------------------------------------------------
    // BUG FIX (round 3 -- the actual root cause): rounds 1/2 (createdBy-first, defensive
    // .get(field,default) reads) both landed and were confirmed live, and the symptom STILL didn't
    // clear -- every list/query against this collection kept failing permission-denied, even a
    // query matching ZERO real documents (confirmed directly in the browser console, bypassing the
    // app entirely: both `where("entityId","in",[...])` and the plain `where("entityId","==",...)`
    // equivalent failed identically; a `where("email","==", <a value matching no document at
    // all>)` query ALSO failed). That last one is the tell: an empty result set has nothing for a
    // per-document rule to evaluate against, so a rule that's merely "false for this data" can
    // never explain it -- something about the QUERY ITSELF was categorically unprovable.
    //
    // The actual mechanism: Firestore's rule engine, before it will run a `list`/query request at
    // all, must be able to prove the rule holds for anything the query's own filters could
    // possibly return -- and it must do this WITHOUT first fetching a document, since fetching is
    // the very thing authorization is gating. A rule branch like
    // `get(/databases/.../clubs/$(data.entityId))` needs `data.entityId`, a field that only exists
    // once a candidate document has actually been read -- circular, and Firestore can't resolve
    // it, so it refuses the ENTIRE list request outright. Confirmed this is all-or-nothing, not
    // per-branch: `data.createdBy == request.auth.uid` alone needs no get() and would be trivially
    // provable, but sitting in the same `||` expression as the get()-based ownership fallback took
    // the whole compound expression down with it anyway. A plain `get` (single document, ID
    // already known up front) has none of this circularity -- confirmed empirically too, all real
    // invite documents passed individual `get` checks under the exact same rule that denied every
    // list attempt.
    //
    // Fix: `list` now uses a narrower, get()-free check (coOwnerInviteCanList) -- recipient-by-
    // email, or creator-by-uid, both plain resource.data/request.auth comparisons with no cross-
    // document lookup at all. `get` keeps the full check (coOwnerInviteIsSender), including the
    // club/federation-ownership fallback, since a single-document get has no such restriction.
    // Real, deliberate narrowing versus the original design: a co-owner who didn't personally
    // create a given invite currently can't find it via list (only its actual sender or its
    // recipient can) -- would need denormalizing owner/co-owner uids onto the invite doc itself
    // at send time to close that gap without any get() in a list-reachable rule. Not done here;
    // flagging it since /federationRequests' `allow list: if ... canSeeRequest(resource.data)`
    // a little further down has this exact same get()-in-a-list-rule shape and is likely equally
    // broken, just not yet reported -- same fix pattern would apply there too.
    function coOwnerInviteIsRecipient(data) {
      return request.auth.token.email.lower() == data.get('email', '');
    }
    function coOwnerInviteCanList(data) {
      return coOwnerInviteIsRecipient(data) || data.get('createdBy', '') == request.auth.uid;
    }
    function coOwnerInviteIsSender(data) {
      return data.get('createdBy', '') == request.auth.uid
        || (data.get('scope', '') == 'club' && data.get('entityId', '') != ''
            && isClubOwner(get(/databases/$(database)/documents/clubs/$(data.entityId)).data))
        || (data.get('scope', '') == 'federation' && data.get('entityId', '') != ''
            && isFederationOwner(get(/databases/$(database)/documents/federations/$(data.entityId)).data));
    }
    match /coOwnerInvites/{inviteId} {
      allow get: if request.auth != null
        && (coOwnerInviteIsRecipient(resource.data) || coOwnerInviteIsSender(resource.data));
      allow list: if request.auth != null && coOwnerInviteCanList(resource.data);

      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.scope in ['club', 'federation']
        && request.resource.data.entityId is string
        && request.resource.data.email is string
        // A federation has no plain-member tier, so role "member" is only ever valid for a club
        // invite — see clubs/{clubId} branches (F)/(G) above for how each role gets redeemed.
        && request.resource.data.get('role', 'coOwner') in ['member', 'coOwner']
        && (request.resource.data.scope == 'club' || request.resource.data.get('role', 'coOwner') == 'coOwner')
        && coOwnerInviteIsSender(request.resource.data);

      // Recipient may only flip pending -> accepted/declined; sender may only flip pending ->
      // cancelled. Either way, status (and respondedAt) is the only thing this write may change —
      // the accept side-effect itself (joining coOwnerUids and/or memberUids, per role — see
      // clubs/{clubId} branches (F)/(G) and federations/{federationId} branch (F) above) is a
      // SEPARATE write to the club/federation doc, authorized by that doc's own rules, not this one.
      allow update: if request.auth != null && resource.data.status == 'pending' && (
        (coOwnerInviteIsRecipient(resource.data) && request.resource.data.status in ['accepted', 'declined'])
        || (coOwnerInviteIsSender(resource.data) && request.resource.data.status == 'cancelled')
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);

      // Only the sender can clear one, and only once it's resolved (accepted/declined/cancelled) --
      // this is the sender's own "here's what happened to the invite I sent" acknowledgement card
      // (see outgoingCoOwnerInvites in inboxScreen.js), not the invite itself while it's still live.
      // A pending invite is withdrawn via the update rule above (status -> cancelled), never deleted
      // outright, so the recipient can't have it silently vanish out from under them mid-flight.
      allow delete: if request.auth != null && coOwnerInviteIsSender(resource.data) && resource.data.status != 'pending';
    }

    // A directory entry publishes one club's team name as visible to every OTHER club sharing
    // this same federation. Read is open to any signed-in user — this is intentionally a name
    // directory, not a security boundary, exactly like what a federation invite itself grants
    // (see joinFederationWithCode in index.html). A write is only valid if the writer is that
    // club's owner/co-owner AND that club currently lists this federation in its own
    // federationIds AND the federation hasn't blocklisted that club (kickedClubIds — see
    // kickClubFromFederation in index.html for why a "kick" lives here rather than as a write to
    // the target club's own document, which this app never allows). Existing stale entries are
    // cleaned up client-side by leaveFederation()/kickClubFromFederation() rather than by this
    // rule; losing federation affiliation or club ownership just blocks further writes.
    match /federations/{federationId}/teams/{entryId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.clubId is string
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data)
        && federationId in get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.get('federationIds', [])
        && !(request.resource.data.clubId in get(/databases/$(database)/documents/federations/$(federationId)).data.get('kickedClubIds', []));

      allow delete: if request.auth != null
        && (
          isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data)
          || isFederationOwner(get(/databases/$(database)/documents/federations/$(federationId)).data)
        );
    }

    // A federation's member directory — one doc per affiliated club ({clubId, clubName}), written
    // the moment a club's affiliation is confirmed (both accept paths in index.html) regardless of
    // whether that club has published any teams yet. This exists because affiliatedClubIds on the
    // federation doc (see canSyncFederationClubJoin/Leave above) is the authoritative membership
    // list but carries no club name, and a federation owner has no read access to a club doc they
    // don't belong to (see clubs/{clubId} read rule) — so without this doc a club with zero
    // published teams would be affiliated but permanently nameless to everyone but itself. Same
    // write shape and same reasoning as federations/{federationId}/teams just below: the joining
    // club's own owner writes it (they have read access to their own club doc to source the name),
    // and either side can delete it (self-leave or being kicked).
    match /federations/{federationId}/members/{clubId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.clubId == clubId
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(clubId)).data)
        && federationId in get(/databases/$(database)/documents/clubs/$(clubId)).data.get('federationIds', [])
        && !(clubId in get(/databases/$(database)/documents/federations/$(federationId)).data.get('kickedClubIds', []));

      allow delete: if request.auth != null
        && (
          isClubOwner(get(/databases/$(database)/documents/clubs/$(clubId)).data)
          || isFederationOwner(get(/databases/$(database)/documents/federations/$(federationId)).data)
        );
    }

    // ---------------------------------------------------------------------
    // Public directories — a lightweight denormalized entry so a club or federation can be found
    // by search WITHOUT exposing the real document (roster, pending invites, description). A
    // club/federation owner publishes exactly one of these the moment they flip visibility to
    // "public" (see setClubVisibility/setFederationVisibility in index.html), and it's deleted the
    // instant they go private again. Same "found by design" trust level as the /players directory
    // above — read is open to any signed-in user so the search UI can just list the whole (small)
    // collection and filter client-side.
    //
    // /clubDirectory also carries ownerUid/coOwnerUids (not just name/ownerName) — not for search,
    // but so a federation owner proposing a "federation_to_club" request (see /federationRequests
    // below) can read the target PUBLIC club's owner/co-owner uids client-side to denormalize them
    // onto the request as toOwnerUids, without needing club membership: reading the real /clubs
    // doc requires being a member (see clubs/{clubId} read rule), which a federation owner
    // proposing to a club they don't belong to never is. This mirror can go stale if the club's
    // ownership changes after it last republished (only setClubVisibility(true) refreshes it, same
    // pre-existing staleness as name/ownerName) — accepted for the same reason those already are:
    // a spoofed or stale value here can't itself grant anything, since federationRequests' create
    // rule validates toOwnerUids against the REAL /clubs doc, not this mirror.
    // ---------------------------------------------------------------------
    match /clubDirectory/{clubId} {
      allow get, list: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.clubId == clubId
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(clubId)).data)
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.get('visibility', 'private') == 'public';
      allow delete: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(clubId)).data);
    }

    match /federationDirectory/{federationId} {
      allow get, list: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.federationId == federationId
        && isFederationOwner(get(/databases/$(database)/documents/federations/$(federationId)).data)
        && get(/databases/$(database)/documents/federations/$(federationId)).data.get('visibility', 'private') == 'public';
      allow delete: if request.auth != null
        && isFederationOwner(get(/databases/$(database)/documents/federations/$(federationId)).data);
    }

    // ---------------------------------------------------------------------
    // Public user directory — lets a signed-in person opt their OWN account into being findable by
    // name (see setMyProfileVisibility in index.html), so a club/federation owner inviting a
    // co-owner or member isn't limited to "already know their exact email" the way every invite
    // flow otherwise is. Private by default: a doc here only exists if that person deliberately
    // published one, deleted the instant they opt back out (same publish/unpublish shape as
    // clubDirectory/federationDirectory above) — nobody is discoverable without asking to be.
    //
    // Unlike a club or federation, an account has no separate "owner" who could vouch for it, so
    // the create/update rule instead pins every field to the caller's own verified identity: name
    // is theirs to set freely (same as the profile display name elsewhere in the app), but email
    // must equal their own token email and photoURL must equal their own token's `picture` claim
    // exactly (or be absent/null) — same "can't spoof a photo" reasoning as players' auto-link
    // branch (B) on clubs/{clubId}. Nothing here can be used to impersonate or misdirect an invite
    // to someone else, since every field a searcher would act on is independently re-derived from
    // the searcher's own knowledge of the real person, not just trusted from this doc blindly --
    // and the actual invite this feeds into still targets the plain `email` field either way,
    // identical to typing it in by hand.
    // ---------------------------------------------------------------------
    match /userDirectory/{uid} {
      allow get, list: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.get('photoURL', null) == request.auth.token.get('picture', null);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------------
    // Federation <-> club affiliation requests. Replaces the old federationJoinCodes email/code
    // flow entirely (that collection's rules above are dead now, kept only so nothing throws for
    // whatever's mid-flight; nothing in the app creates new ones any more). Either side can
    // propose: a club owner requesting to join a PUBLIC federation ("club_to_federation"), or a
    // federation owner inviting a PUBLIC club ("federation_to_club"). The OTHER side accepts or
    // declines. Accepting a "federation_to_club" request lets the club owner write
    // clubs/{clubId}.federationIds directly in the very same action, since a club owner already
    // has unrestricted write access to their own federationIds (see clubs/{clubId} branch A) —
    // no new capability needed there. Accepting a "club_to_federation" request only flips status
    // to "accepted" here, because a federation must never get direct write access to a club
    // document; the requesting club's OWNER finishes the join themselves the next time they see
    // the acceptance (status -> "joined", see completeAcceptedFederationRequest in index.html).
    //
    // BUG FIX: `list`/`get` used to be gated on canSeeRequest doing a LIVE
    // isClubOwner(get(clubs/data.clubId)) / isFederationOwner(get(federations/data.federationId))
    // check — the exact same get()-in-a-list-rule shape flagged (but not fixed) when coOwnerInvites
    // hit this same wall; see that collection's BUG FIX comment below for the full mechanism
    // (Firestore can't prove a list request's rule holds without first fetching a document, and
    // fetching is the very thing being authorized, so it refuses the whole request outright,
    // regardless of what data exists). Confirmed here too: loadMyFederationRequests' client query
    // filters by clubId/federationId, neither of which a get()-free rule can vouch for, so this
    // was permission-denied unconditionally the whole time this shape existed — worse than
    // coOwnerInvites' equivalent bug, since (unlike a co-owner invite's recipient-by-email path)
    // there was no field on this doc a get()-free rule COULD check for the receiving side at all.
    //
    // Fix: denormalize the receiving side's owner/co-owner uids onto the request doc itself at
    // create time (toOwnerUids), validated against live ownership in the create rule (get() has no
    // circularity problem in create/update, only in list) so a client can't spoof its way into
    // someone else's toOwnerUids. `get`/`list` then only need fromUid (the sender) or membership in
    // toOwnerUids (the receiving side) — both plain resource.data/request.auth comparisons, no
    // cross-document lookup. For "federation_to_club" the federation owner computing toOwnerUids
    // client-side needs the target club's owner/co-owner uids without being a club member — see
    // /clubDirectory below, now carrying ownerUid/coOwnerUids for exactly this (a public club is
    // already a precondition of this direction, same precondition clubDirectory itself requires).
    // Real, deliberate narrowing: toOwnerUids is a snapshot as of when the request was created — an
    // owner/co-owner added to the receiving side afterward won't see this request in their list
    // (though a still-current owner who WAS on it at creation time can still act on it via `update`
    // below, which uses live ownership, not this snapshot, since update has no list-style
    // circularity to route around). Not closed here.
    // ---------------------------------------------------------------------
    match /federationRequests/{requestId} {
      function canSeeRequest(data) {
        return data.get('fromUid', '') == request.auth.uid
          || request.auth.uid in data.get('toOwnerUids', []);
      }
      allow get: if request.auth != null && canSeeRequest(resource.data);
      allow list: if request.auth != null && canSeeRequest(resource.data);

      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.clubId is string
        && request.resource.data.federationId is string
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toOwnerUids is list
        && (
          (
            request.resource.data.direction == 'club_to_federation' &&
            isClubOwner(get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data) &&
            get(/databases/$(database)/documents/federations/$(request.resource.data.federationId)).data.get('visibility', 'private') == 'public' &&
            request.resource.data.toOwnerUids.hasOnly(
              get(/databases/$(database)/documents/federations/$(request.resource.data.federationId)).data.get('coOwnerUids', [])
                .concat([get(/databases/$(database)/documents/federations/$(request.resource.data.federationId)).data.createdBy])
            )
          )
          ||
          (
            request.resource.data.direction == 'federation_to_club' &&
            isFederationOwner(get(/databases/$(database)/documents/federations/$(request.resource.data.federationId)).data) &&
            get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.get('visibility', 'private') == 'public' &&
            request.resource.data.toOwnerUids.hasOnly(
              get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.get('coOwnerUids', [])
                .concat([get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.ownerUid])
            )
          )
        );

      allow update: if request.auth != null && (
        // Receiving side accepts/declines a still-pending request.
        (
          (
            (resource.data.direction == 'club_to_federation' && isFederationOwner(get(/databases/$(database)/documents/federations/$(resource.data.federationId)).data))
            ||
            (resource.data.direction == 'federation_to_club' && isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data))
          ) &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted', 'declined'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        )
        ||
        // Sending side cancels their own still-pending request.
        (
          (
            (resource.data.direction == 'club_to_federation' && isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data))
            ||
            (resource.data.direction == 'federation_to_club' && isFederationOwner(get(/databases/$(database)/documents/federations/$(resource.data.federationId)).data))
          ) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        )
        ||
        // Club owner finalizing an ACCEPTED club_to_federation request — see comment above.
        (
          resource.data.direction == 'club_to_federation' &&
          resource.data.status == 'accepted' &&
          isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data) &&
          request.resource.data.status == 'joined' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
      );

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Feedback & automatic error reports — a write-only mailbox. Anyone (signed in or not, since
    // an error can happen before sign-in and feedback shouldn't require an account) can file one;
    // NO client can ever read, list, update, or delete ANY of them, including their own — this is
    // deliberately one-directional, like dropping a letter in a mailbox slot. Robin reads these
    // directly in the Firebase Console (Console access isn't bound by these rules at all). Basic
    // shape validation only: a non-empty, size-capped message and a known kind, so this can't be
    // used to dump arbitrary large blobs.
    // ---------------------------------------------------------------------
    // Read/update are opened up to exactly one signed-in email (the app's owner) so feedback and
    // auto-captured error reports can be triaged in-app instead of only via the Firebase Console.
    // Everyone else keeps create-only, write-only access -- see the comment above submitFeedback
    // in index.html for why that stays the default (no way for a submitter, or anyone else, to
    // browse other people's reports). Update is limited to exactly the two admin-set fields so the
    // admin account can never alter what was actually reported.
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.kind in ['feedback', 'error']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 6000;
      allow read: if isAppAdminAuth();
      allow update: if isAppAdminAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolutionNote', 'priority']);
      allow delete: if isAppAdminAuth();
    }

    // ---------------------------------------------------------------------
    // Activity notifications — a durable, per-recipient record of a club/federation membership
    // event: someone joined, left, was removed, had their role changed, or responded to a
    // co-owner/member invite. This app has no server, no push, no email, so this collection IS the
    // notification system: written by the OTHER party's client at the moment of the real
    // membership-changing write (see notifyActivity's call sites in index.html — respondCoOwnerInvite,
    // joinClubWithCode, leaveClub, removeClubMember, removeClubCoOwner, removeFederationCoOwner),
    // read by the recipient the next time they open their Inbox.
    //
    // `create` can't validate full narrative correctness (e.g. that "removed" actually happened) --
    // that would mean re-deriving what a Firestore rule fundamentally can't see, the OLD value of a
    // field that's already been overwritten by the companion write. What it CAN and does check: one
    // of the two parties (actorUid, who must be the caller — no writing on someone else's behalf —
    // or forUid, the recipient) must currently be verifiable owner-tier on the named club/
    // federation, so a stranger with no standing in that club/federation at all can't spam an
    // arbitrary uid. This single "one side is owner-tier" check covers every kind without a
    // per-kind branch: for joined/left the ACTOR is the one who joined/left (maybe just a plain
    // member) and the RECIPIENT is the owner being told about it; for removed/role_changed the
    // ACTOR is the owner who acted and the RECIPIENT is the affected person (maybe just a plain
    // member); for invite_response the ACTOR is whoever responded (not owner-tier if they declined,
    // or if they accepted a plain member-role invite) and the RECIPIENT is the invite's sender (an
    // owner/co-owner, by construction of coOwnerInvites' own create rule) — recipient-side coverage
    // handles every one of these on its own even when the actor-side check doesn't.
    //
    // Same "get() is fine in create, only list has the circularity problem" distinction as every
    // other collection in this file that hit that wall (coOwnerInvites, federationRequests above).
    // ---------------------------------------------------------------------
    function isClubOwnerTierUid(club, uid) {
      return uid == club.ownerUid || uid in club.get('coOwnerUids', []);
    }
    function isFederationOwnerTierUid(federation, uid) {
      return uid == federation.createdBy || uid in federation.get('coOwnerUids', []);
    }
    match /activity/{activityId} {
      allow get: if request.auth != null && resource.data.forUid == request.auth.uid;
      allow list: if request.auth != null && resource.data.forUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.forUid is string
        && request.resource.data.forUid != request.auth.uid
        && request.resource.data.scope in ['club', 'federation']
        && request.resource.data.kind in ['joined', 'left', 'removed', 'role_changed', 'invite_response']
        && request.resource.data.entityId is string
        && (
          (
            request.resource.data.scope == 'club' &&
            (
              isClubOwnerTierUid(get(/databases/$(database)/documents/clubs/$(request.resource.data.entityId)).data, request.auth.uid)
              || isClubOwnerTierUid(get(/databases/$(database)/documents/clubs/$(request.resource.data.entityId)).data, request.resource.data.forUid)
            )
          )
          ||
          (
            request.resource.data.scope == 'federation' &&
            (
              isFederationOwnerTierUid(get(/databases/$(database)/documents/federations/$(request.resource.data.entityId)).data, request.auth.uid)
              || isFederationOwnerTierUid(get(/databases/$(database)/documents/federations/$(request.resource.data.entityId)).data, request.resource.data.forUid)
            )
          )
        );

      // The recipient may only ever flip their own `read` flag -- nothing else about a
      // notification is theirs to change, and no one (including the actor who sent it) can ever
      // edit what it says after the fact.
      allow update: if request.auth != null && resource.data.forUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // The recipient can clear their own notification once they've seen it -- this is their own
      // copy of "you were told about X", not the historical record of X itself (that's the real
      // club/federation doc, or the coOwnerInvites doc, neither of which this touches), so deleting
      // it has no effect on anyone else or on what actually happened.
      allow delete: if request.auth != null && resource.data.forUid == request.auth.uid;
    }

    // Existence-only admin registry -- a doc at /admins/{uid} means that uid is an admin, checked
    // by isAppAdminAuth() above. A user may only read their OWN doc (existence, no field
    // values needed), never list the collection, so this can't be used to enumerate who else is
    // an admin. No client write path at all -- adding/removing an admin is a Firebase Console (or
    // Admin SDK) action, the same trust tier as reviewing /feedback itself in the console before
    // the in-app inbox existed.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }
  }
}
