rules_version = '2';

// Firestore Security Rules for cricket-scorer.
//
// This file is not auto-deployed — paste it into Firebase Console → Firestore Database → Rules
// → Publish. Keeping it in the repo is so the actual access-control model has a diff history,
// instead of living only as tribal knowledge in the console.
//
// ---- The trust model in one paragraph ----
// This app has three tiers of data, each with a different capability:
//   1. /users/{uid}/...        — private to one signed-in Google account.
//   2. /sharedMatches/{code}   — a match code is a bearer capability for FULL scoring access.
//                                 Anyone who has the code (signed in or not) can read AND write it.
//   3. /liveViews/{code}       — a view code is a bearer capability for READ-ONLY access. A
//                                 DIFFERENT collection from #2, keyed by a DIFFERENT random code,
//                                 so a view code can never be used to gain scoring access no
//                                 matter what a viewer does with it — there is no document at
//                                 that code inside /sharedMatches for it to match.
// Clubs add a fourth tier: shared-but-not-public team rosters and tournaments, gated by Google
// account membership rather than a bearer code, because unlike a single match you actually want
// to know (and be able to revoke) who's in a club.
// Federations add a fifth, much thinner tier on top of clubs: a club can opt into a federation
// (e.g. "DCF") the same way a person joins a club, but a federation grants no membership,
// matches, or roster access of its own — only a read-only name directory (federations/{id}/teams)
// that says "this club has a team called X", so a tournament organizer in one member club can
// pick another member club's team without ever seeing that club's private data.
// Players add a sixth tier, thinner still: a directory entry for one real person, keyed by email,
// that any club's owner/co-owner can publish (make public/borrowable) or a roster can simply
// reference by email without publishing anything at all. See the /players/{playerEmail} rule
// below for the full reasoning.
//
// ---- The permission model in one paragraph ----
// Clubs and federations each have exactly one privileged tier: "owner", which covers both the
// original creator (ownerUid on a club, createdBy on a federation) and anyone granted
// co-ownership (coOwnerUids on both). Owner and co-owner have IDENTICAL rights — there is no
// separate "admin" tier anymore. Only an owner/co-owner can rename, edit the description, invite
// people, manage teams/tournaments, remove members, or manage federation affiliation. Plain
// members (memberUids on a club) can be picked into rosters and read what they're a member of,
// but cannot write to any of it. Every invite in the app — becoming a member, becoming a
// co-owner, or a club affiliating with a federation — is addressed to one specific email address
// and can only be redeemed by someone signed in as that exact email (request.auth.token.email).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Personal account data — matches, teams, profile, house rules.
    // Only the signed-in owner can ever read or write their own subtree.
    // ---------------------------------------------------------------------
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------------
    // Beta tester flag. Deliberately its OWN top-level collection rather than
    // living under /users/{uid} — the rule above grants the signed-in owner
    // full write access to their own subtree, which would let anyone flip
    // their own beta flag on from the browser console. Read-only from the
    // client; only edited via the Firebase Console (or an admin script),
    // which bypasses these rules entirely.
    // ---------------------------------------------------------------------
    match /betaTesters/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Full-access co-scoring. Knowledge of the 8-character code IS the credential — this is
    // intentional (it's how a teammate resumes scoring on another phone with no account needed)
    // and is unchanged from before. What changed is that this code is no longer also accepted as
    // a "read-only" link — see /liveViews below.
    //
    // `list` is explicitly denied and `get` is the only read path: `allow read: if true` would
    // grant BOTH, and a bare `.collection("sharedMatches").get()` with no filter would then dump
    // every shared match ever created — full rosters, scores, everything packMatchForFirestore
    // writes — to anyone on the internet, code or no code, since firebaseConfig is necessarily
    // public in a client-only app. A code is meant to be a capability you must already KNOW, not
    // one more document in an enumerable collection. See /tournamentMatches below for how the one
    // legitimate need to query this collection by tournamentId is served without that query ever
    // touching sharedMatches directly.
    // ---------------------------------------------------------------------
    match /sharedMatches/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Read-only live-follow mirror. Same open-by-code trust model as sharedMatches, but it is a
    // SEPARATE collection so a view code and a score code are never interchangeable. The app
    // only ever writes here from the match owner's client (see saveMatch/liveViews mirror write
    // in index.html) and only ever reads here from FollowScreen, which has no scoring controls.
    //
    // Same get-only reasoning as /sharedMatches above — `list` stays denied so this collection
    // can't be dumped wholesale either.
    // ---------------------------------------------------------------------
    match /liveViews/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Read-only tournament share snapshot. Same open-by-code, owner-writes/anyone-reads trust
    // model as /liveViews — a SEPARATE collection again so a tournament share code can never be
    // confused with a match code or view code from a different feature. Deliberately a snapshot,
    // not a live mirror: tournaments live under /clubs/{clubId}/tournaments/{id} or a personal
    // meta doc, and their standings depend on match results that live elsewhere again (private
    // per-user or per-club match data) — keeping that fully in sync on every relevant write would
    // mean touching this collection from several other write paths in the app. The client
    // (shareTournament in index.html) writes a fresh standings/fixtures snapshot here whenever the
    // owner opens the share panel and hits refresh, not on every match update.
    //
    // Same get-only reasoning as /sharedMatches above — `list` stays denied.
    // ---------------------------------------------------------------------
    match /tournamentViews/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }

    // ---------------------------------------------------------------------
    // Pointer index for "find every shared match tagged with tournament X" (loadTournamentMatches
    // in index.html), so standings/stats computation never has to run an unscoped query against
    // /sharedMatches itself. Each entry is just {tournamentId, matchId, shareCode} — enough to
    // resolve to a `get` on the real match doc, nothing else. Reading it still requires being
    // signed in AND already knowing a specific tournamentId (a query here is inherently scoped to
    // one tournament's subcollection — there is no way to query "every entry across every
    // tournament" without a collection-group rule, which this file deliberately never grants), so
    // this narrows the old exposure down to "you already have legitimate access to this one
    // tournament" rather than "you can dump the whole app's match history in one query."
    // Writes are unauthenticated on purpose, same as /sharedMatches itself: a guest scoring a
    // match via a code with no account still needs to be able to register it here if that match
    // carries a tournamentId.
    // ---------------------------------------------------------------------
    match /tournamentMatches/{tournamentId}/entries/{entryId} {
      allow get, list: if request.auth != null;
      allow create, update: if request.resource.data.tournamentId == tournamentId
        && request.resource.data.matchId is string
        && request.resource.data.shareCode is string;
      allow delete: if true;
    }

    // ---------------------------------------------------------------------
    // Clubs — shared team rosters gated by Google-account membership, not a bearer code.
    // Owner and co-owner are functionally identical throughout — every helper below treats them
    // as one tier by checking both ownerUid and coOwnerUids.
    // ---------------------------------------------------------------------
    function isClubOwner(club) {
      return request.auth.uid == club.ownerUid || request.auth.uid in club.get('coOwnerUids', []);
    }

    match /clubs/{clubId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.get('coOwnerUids', []) == [];

      allow update: if request.auth != null && (
        // (A) Owner/co-owner editing general club data (name, description, federationIds, and so
        // on). Membership, ownership, and the co-owner list itself must not change via this
        // branch — that's what (B)/(C)/(D) are for. Uses get(field, default) throughout because
        // clubs created before this field existed have no coOwnerUids field at all — a bare
        // resource.data.coOwnerUids on one of those errors out the whole check rather than
        // reading as empty.
        (
          isClubOwner(resource.data) &&
          request.resource.data.memberUids == resource.data.memberUids &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.get('coOwnerUids', []) == resource.data.get('coOwnerUids', [])
        )
        ||
        // (B) Self-redeeming a club invite addressed to MY signed-in email — see
        // joinClubWithCode/inviteClubMemberByEmail/inviteClubCoOwnerByEmail in index.html. The
        // invite code names exactly this club, this exact email, and hasn't expired. Depending on
        // the code's own `role` field the redeemer lands in memberUids only, or in memberUids AND
        // coOwnerUids — nothing else about the doc may change in the same write.
        (
          !(request.auth.uid in resource.data.memberUids) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.name == resource.data.name &&
          'joinCodeUsed' in request.resource.data &&
          get(/databases/$(database)/documents/clubJoinCodes/$(request.resource.data.joinCodeUsed)).data.clubId == clubId &&
          get(/databases/$(database)/documents/clubJoinCodes/$(request.resource.data.joinCodeUsed)).data.expiresAt > request.time.toMillis() &&
          get(/databases/$(database)/documents/clubJoinCodes/$(request.resource.data.joinCodeUsed)).data.email == request.auth.token.email.lower() &&
          request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid]) &&
          (
            (
              get(/databases/$(database)/documents/clubJoinCodes/$(request.resource.data.joinCodeUsed)).data.role == "coOwner" &&
              request.resource.data.coOwnerUids == resource.data.get('coOwnerUids', []).concat([request.auth.uid])
            )
            ||
            (
              get(/databases/$(database)/documents/clubJoinCodes/$(request.resource.data.joinCodeUsed)).data.role != "coOwner" &&
              request.resource.data.get('coOwnerUids', []) == resource.data.get('coOwnerUids', [])
            )
          )
        )
        ||
        // (C) Self-leave. Anyone but the owner can remove only themselves — also drops
        // themselves from coOwnerUids, if they were one.
        (
          request.auth.uid in resource.data.memberUids &&
          request.auth.uid != resource.data.ownerUid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid]) &&
          request.resource.data.get('coOwnerUids', []) == resource.data.get('coOwnerUids', []).removeAll([request.auth.uid])
        )
        ||
        // (D) Owner/co-owner removing someone else (member or co-owner), or pruning the list —
        // ownership itself (ownerUid) can't change here (that would need an explicit transfer
        // flow, deliberately not built). coOwnerUids must stay a subset of whatever memberUids
        // ends up as, so a removed member can't linger as a co-owner.
        (
          isClubOwner(resource.data) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.memberUids.hasOnly(resource.data.memberUids) &&
          request.resource.data.get('coOwnerUids', []).hasOnly(request.resource.data.memberUids)
        )
        ||
        // (E) Any current member correcting their OWN display name in memberNames — e.g. when it
        // was stored blank/generic because their Google account had no display name set at the
        // time they joined, and they've since signed in with a proper name or the client falls
        // back to their email instead. Scoped to exactly one key so a member can never touch
        // anyone else's entry, membership, or anything else on the doc.
        (
          request.auth.uid in resource.data.memberUids &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberNames']) &&
          request.resource.data.memberNames.diff(resource.data.get('memberNames', {})).affectedKeys().hasOnly([request.auth.uid])
        )
      );

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // Owner/co-owner only — plain members can read a club's teams (to pick them for scoring) but
    // never write to them.
    match /clubs/{clubId}/teams/{teamId} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberUids;
      allow write: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(clubId)).data);
    }

    match /clubs/{clubId}/tournaments/{tournamentId} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberUids;
      allow write: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(clubId)).data);
    }

    // ---------------------------------------------------------------------
    // Players — a directory entry for a real person, keyed by their (lowercased) email so the
    // same person resolves to the same doc no matter which club adds them: e.g. two clubs each
    // adding "alex@x.com" to a roster share one Player, rather than becoming two unrelated
    // people. A roster entry with no email is just a plain name, exactly as before this
    // collection existed — nothing here is required.
    //
    // homeClubId is whichever club FIRST published this player (made them public/borrowable) and
    // is the only club whose owner/co-owner can edit or unpublish them; it's immutable afterward,
    // same reasoning as ownerUid on a club. linkedUid is set once, automatically, the moment
    // someone signs in with this exact email (see linkPlayerIfMatch in index.html) — it can only
    // ever move from unset to that one specific person, never reassigned or cleared via this rule.
    //
    // Reads are open to any signed-in user, not just the home club — needed for the cross-club
    // "browse public players" directory itself to work as a query rather than a per-doc lookup.
    // Same "found by design, small and listable" trust level as /clubDirectory and
    // /federationDirectory below: nothing sensitive lives on this doc beyond a name and an email,
    // and it's genuinely meant to be found by other clubs, unlike club/federation membership data
    // or a match/view code (which stay get-only precisely because they're NOT meant to be found —
    // see /sharedMatches above).
    // ---------------------------------------------------------------------
    match /players/{playerEmail} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;

      allow create: if request.auth != null
        && playerEmail == request.resource.data.email
        && request.resource.data.get('linkedUid', null) == null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(request.resource.data.homeClubId)).data);

      allow update: if request.auth != null && (
        // (A) Home club's owner/co-owner editing name/public. homeClubId, email, and linkedUid
        // must not change via this branch — homeClubId transfer isn't supported (same reasoning
        // as a club's ownerUid never moving through its general-edit branch), and linkedUid is
        // exclusively branch (B)'s to set.
        (
          isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.homeClubId)).data) &&
          request.resource.data.homeClubId == resource.data.homeClubId &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.get('linkedUid', null) == resource.data.get('linkedUid', null)
        )
        ||
        // (B) Auto-link on sign-in: the signed-in person's own verified email exactly matches
        // this doc, nobody's linked to it yet, and the only fields changing are linkedUid (to
        // exactly this person's own uid) and, optionally, photoURL — see linkPlayerIfMatch in
        // index.html. photoURL must come verbatim from the auth token's own `picture` claim
        // (never an arbitrary client-supplied value), so this can only ever mirror the signed-in
        // person's own Google account picture, not attach an arbitrary image to someone else.
        (
          request.auth.token.email.lower() == resource.data.email &&
          resource.data.get('linkedUid', null) == null &&
          request.resource.data.linkedUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid', 'photoURL']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoURL']) ||
            request.resource.data.photoURL == request.auth.token.get('picture', null)
          )
        )
      );

      allow delete: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.homeClubId)).data);
    }

    // ---------------------------------------------------------------------
    // Club invite codes. A single collection covers both kinds of club invite — becoming a plain
    // member, or becoming a co-owner — distinguished by the code doc's own `role` field (checked
    // against the redeemer's signed-in email in the clubs/{clubId} update rule, branch B, not
    // here). A code is a single-purpose capability token: any signed-in user can look one up by
    // its exact ID (that's how redeeming resolves code → clubId), but only the club's
    // owner/co-owner can mint or revoke one.
    // ---------------------------------------------------------------------
    match /clubJoinCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.clubId is string
        && request.resource.data.email is string
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data);

      allow delete: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data);

      allow update: if false; // codes are immutable — rotate by delete + create instead
    }

    // ---------------------------------------------------------------------
    // Federations — a light umbrella tag (e.g. "DCF") that clubs opt into via an email-locked
    // invite, same bearer-capability-plus-email pattern as a club invite. Same owner/co-owner
    // tier as clubs — createdBy is the permanent primary owner, coOwnerUids holds anyone else
    // granted identical rights via email invite.
    // ---------------------------------------------------------------------
    function isFederationOwner(federation) {
      return request.auth.uid == federation.createdBy || request.auth.uid in federation.get('coOwnerUids', []);
    }
    // Helpers for keeping federations/{id}.affiliatedClubIds in sync with which clubs currently
    // list this federation in their OWN federationIds (the source of truth). This denormalized
    // list exists for exactly one reason: it's what makes "delete an EMPTY federation" (see the
    // delete rule below) checkable at all — a security rule can never run a query across the whole
    // clubs collection to ask "does any club still reference me?", so the only way to know is to
    // maintain the answer as data, updated by whichever club owner is actually joining/leaving
    // (see joinFederationWithCode/leaveFederation/respondFederationRequest/
    // completeAcceptedFederationRequest/kickClubFromFederation/deleteClub in index.html — every
    // site that touches a club's federationIds also makes the matching companion write here).
    // Each helper is scoped to touching exactly one id, on exactly this field, by exactly the
    // owner/co-owner of the one club being added or removed — nothing else about the federation
    // doc may change in the same write, and the caller can never claim to add/remove someone
    // else's club.
    function canSyncFederationClubJoin(federationId, oldIds, newIds) {
      let added = newIds.removeAll(oldIds);
      return added.size() == 1
        && oldIds.hasOnly(newIds)
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(added[0])).data)
        && federationId in get(/databases/$(database)/documents/clubs/$(added[0])).data.get('federationIds', []);
    }
    function canSyncFederationClubLeave(oldIds, newIds) {
      let removed = oldIds.removeAll(newIds);
      return removed.size() == 1
        && newIds.hasOnly(oldIds)
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(removed[0])).data);
    }

    match /federations/{federationId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if request.auth != null && (
        // (A) Owner/co-owner editing federation data (rename, description, kickedClubIds,
        // affiliatedClubIds — e.g. kickClubFromFederation removing an entry on their own doc).
        // coOwnerUids and createdBy must not change via this branch — that's what (B) is for.
        // get(field, default) handles federations from before these fields existed.
        (
          isFederationOwner(resource.data) &&
          request.resource.data.get('coOwnerUids', []) == resource.data.get('coOwnerUids', []) &&
          request.resource.data.createdBy == resource.data.createdBy
        )
        ||
        // (B) Self-redeeming a co-owner invite code addressed to MY signed-in email — see
        // inviteFederationCoOwnerByEmail/redeemFederationCoOwnerInvite in index.html. Only adds
        // the caller to coOwnerUids; name/description/createdBy locked, and the code must
        // actually name this federation and this exact email.
        (
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.coOwnerUids == resource.data.get('coOwnerUids', []).concat([request.auth.uid]) &&
          'coOwnerInviteCodeUsed' in request.resource.data &&
          get(/databases/$(database)/documents/federationCoOwnerInviteCodes/$(request.resource.data.coOwnerInviteCodeUsed)).data.federationId == federationId &&
          get(/databases/$(database)/documents/federationCoOwnerInviteCodes/$(request.resource.data.coOwnerInviteCodeUsed)).data.email == request.auth.token.email.lower()
        )
        ||
        // (C) Removing one or more co-owners — coOwnerUids may only SHRINK (become a subset of
        // what it was), never grow or add anyone new (that's what (B) is for). Covers both the
        // owner/a co-owner removing a DIFFERENT co-owner (see removeFederationCoOwner in
        // index.html — previously impossible under this rule, since (A) locks coOwnerUids
        // entirely), and a co-owner removing THEMSELVES (mirrors clubs' self-leave branch; also
        // what account deletion relies on to clean up a departing co-owner's federations, see
        // deleteUserAccount). createdBy can never be removed this way — deliberately: there is no
        // ownership-transfer flow, so the original creator is a permanent, unremovable anchor
        // (though the federation ITSELF can now be deleted once empty — see below).
        (
          isFederationOwner(resource.data) &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.get('coOwnerUids', []).hasOnly(resource.data.get('coOwnerUids', []))
        )
        ||
        // (D) A club owner/co-owner syncing THEIR OWN club's id into affiliatedClubIds right
        // after affiliating. Requires that club to already list this federation in its own
        // federationIds, so this can only mirror a join that genuinely just happened elsewhere,
        // never manufacture one.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['affiliatedClubIds']) &&
          canSyncFederationClubJoin(federationId, resource.data.get('affiliatedClubIds', []), request.resource.data.affiliatedClubIds)
        )
        ||
        // (E) A club owner/co-owner syncing THEIR OWN club's id back OUT of affiliatedClubIds —
        // self-leaving, or the last step of deleting their own club while it's still affiliated.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['affiliatedClubIds']) &&
          canSyncFederationClubLeave(resource.data.get('affiliatedClubIds', []), request.resource.data.affiliatedClubIds)
        )
      );

      // A federation can be deleted once it's EMPTY — no club currently affiliated — by its
      // owner/co-owner. Safe specifically because affiliatedClubIds (kept in sync by (D)/(E)
      // above and by branch (A) for kicks) is the authoritative "is anything still relying on
      // this?" signal; there is deliberately still no ownership-transfer flow, so only the
      // permanent owner tier can do this, same as every other federation-level action.
      allow delete: if request.auth != null
        && isFederationOwner(resource.data)
        && resource.data.get('affiliatedClubIds', []).size() == 0;
    }

    // A federation-hosted tournament — read is open to any signed-in user, the SAME trust tier as
    // the federation document itself and its team directory just above (federations/{federationId},
    // federations/{federationId}/teams/{entryId}): a federation was already designed as a
    // semi-public directory rather than a private space like a club, so this doesn't introduce any
    // new exposure, it just extends the same openness to cover the one thing a federation would
    // naturally want to host. The alternative — gating reads to "member of any affiliated club" —
    // would mean looping every affiliated club's membership inside the rule itself, bounded by
    // Firestore's per-request lookup limit; a federation with a lot of affiliated clubs could start
    // failing unpredictably purely from having grown. Write stays locked to the owner tier, same as
    // every other federation-level action (creating/editing fixtures, deleting the tournament, etc.
    // are all the same "owner or co-owner" check as clubs/{clubId}/tournaments/{tournamentId}
    // above uses for club-hosted tournaments).
    match /federations/{federationId}/tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && isFederationOwner(get(/databases/$(database)/documents/federations/$(federationId)).data);
    }

    // A club-affiliation invite, addressed to one email. Only that signed-in email may even read
    // the code (so a stranger can't discover which federation it points to); redeeming it is a
    // write to the CLUB's own federationIds, enforced by the clubs/{clubId} update rule's general
    // branch (A), which already requires the caller to be that club's owner/co-owner.
    match /federationJoinCodes/{code} {
      allow get: if request.auth != null
        && resource.data.email == request.auth.token.email.lower();
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.federationId is string
        && request.resource.data.email is string
        && isFederationOwner(get(/databases/$(database)/documents/federations/$(request.resource.data.federationId)).data);

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      allow update: if false;
    }

    // A co-owner invite is addressed to one specific email, same pattern as a club co-owner
    // invite — anyone can look it up by ID, but it only becomes a real co-owner grant if the
    // redeemer's own signed-in email matches (enforced in the federations/{id} update rule,
    // branch B, not here — this collection only controls who can mint/revoke the invite itself).
    match /federationCoOwnerInviteCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.federationId is string
        && request.resource.data.email is string
        && isFederationOwner(get(/databases/$(database)/documents/federations/$(request.resource.data.federationId)).data);

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      allow update: if false;
    }

    // A directory entry publishes one club's team name as visible to every OTHER club sharing
    // this same federation. Read is open to any signed-in user — this is intentionally a name
    // directory, not a security boundary, exactly like what a federation invite itself grants
    // (see joinFederationWithCode in index.html). A write is only valid if the writer is that
    // club's owner/co-owner AND that club currently lists this federation in its own
    // federationIds AND the federation hasn't blocklisted that club (kickedClubIds — see
    // kickClubFromFederation in index.html for why a "kick" lives here rather than as a write to
    // the target club's own document, which this app never allows). Existing stale entries are
    // cleaned up client-side by leaveFederation()/kickClubFromFederation() rather than by this
    // rule; losing federation affiliation or club ownership just blocks further writes.
    match /federations/{federationId}/teams/{entryId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.clubId is string
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data)
        && federationId in get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.get('federationIds', [])
        && !(request.resource.data.clubId in get(/databases/$(database)/documents/federations/$(federationId)).data.get('kickedClubIds', []));

      allow delete: if request.auth != null
        && (
          isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data)
          || isFederationOwner(get(/databases/$(database)/documents/federations/$(federationId)).data)
        );
    }

    // ---------------------------------------------------------------------
    // Public directories — a lightweight denormalized entry (name + owner name only) so a club or
    // federation can be found by search WITHOUT exposing the real document (roster, member uids,
    // pending invites, description). A club/federation owner publishes exactly one of these the
    // moment they flip visibility to "public" (see setClubVisibility/setFederationVisibility in
    // index.html), and it's deleted the instant they go private again. Same "found by design"
    // trust level as the /players directory above — read is open to any signed-in user so the
    // search UI can just list the whole (small) collection and filter client-side.
    // ---------------------------------------------------------------------
    match /clubDirectory/{clubId} {
      allow get, list: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.clubId == clubId
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(clubId)).data)
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.get('visibility', 'private') == 'public';
      allow delete: if request.auth != null
        && isClubOwner(get(/databases/$(database)/documents/clubs/$(clubId)).data);
    }

    match /federationDirectory/{federationId} {
      allow get, list: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.federationId == federationId
        && isFederationOwner(get(/databases/$(database)/documents/federations/$(federationId)).data)
        && get(/databases/$(database)/documents/federations/$(federationId)).data.get('visibility', 'private') == 'public';
      allow delete: if request.auth != null
        && isFederationOwner(get(/databases/$(database)/documents/federations/$(federationId)).data);
    }

    // ---------------------------------------------------------------------
    // Federation <-> club affiliation requests. Replaces the old federationJoinCodes email/code
    // flow entirely (that collection's rules above are dead now, kept only so nothing throws for
    // whatever's mid-flight; nothing in the app creates new ones any more). Either side can
    // propose: a club owner requesting to join a PUBLIC federation ("club_to_federation"), or a
    // federation owner inviting a PUBLIC club ("federation_to_club"). The OTHER side accepts or
    // declines. Accepting a "federation_to_club" request lets the club owner write
    // clubs/{clubId}.federationIds directly in the very same action, since a club owner already
    // has unrestricted write access to their own federationIds (see clubs/{clubId} branch A) —
    // no new capability needed there. Accepting a "club_to_federation" request only flips status
    // to "accepted" here, because a federation must never get direct write access to a club
    // document; the requesting club's OWNER finishes the join themselves the next time they see
    // the acceptance (status -> "joined", see completeAcceptedFederationRequest in index.html).
    // ---------------------------------------------------------------------
    match /federationRequests/{requestId} {
      function canSeeRequest(data) {
        return isClubOwner(get(/databases/$(database)/documents/clubs/$(data.clubId)).data)
          || isFederationOwner(get(/databases/$(database)/documents/federations/$(data.federationId)).data);
      }
      allow get: if request.auth != null && canSeeRequest(resource.data);
      allow list: if request.auth != null && canSeeRequest(resource.data);

      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.clubId is string
        && request.resource.data.federationId is string
        && (
          (
            request.resource.data.direction == 'club_to_federation' &&
            isClubOwner(get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data) &&
            get(/databases/$(database)/documents/federations/$(request.resource.data.federationId)).data.get('visibility', 'private') == 'public'
          )
          ||
          (
            request.resource.data.direction == 'federation_to_club' &&
            isFederationOwner(get(/databases/$(database)/documents/federations/$(request.resource.data.federationId)).data) &&
            get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.get('visibility', 'private') == 'public'
          )
        );

      allow update: if request.auth != null && (
        // Receiving side accepts/declines a still-pending request.
        (
          (
            (resource.data.direction == 'club_to_federation' && isFederationOwner(get(/databases/$(database)/documents/federations/$(resource.data.federationId)).data))
            ||
            (resource.data.direction == 'federation_to_club' && isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data))
          ) &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted', 'declined'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        )
        ||
        // Sending side cancels their own still-pending request.
        (
          (
            (resource.data.direction == 'club_to_federation' && isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data))
            ||
            (resource.data.direction == 'federation_to_club' && isFederationOwner(get(/databases/$(database)/documents/federations/$(resource.data.federationId)).data))
          ) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        )
        ||
        // Club owner finalizing an ACCEPTED club_to_federation request — see comment above.
        (
          resource.data.direction == 'club_to_federation' &&
          resource.data.status == 'accepted' &&
          isClubOwner(get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data) &&
          request.resource.data.status == 'joined' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
      );

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Feedback & automatic error reports — a write-only mailbox. Anyone (signed in or not, since
    // an error can happen before sign-in and feedback shouldn't require an account) can file one;
    // NO client can ever read, list, update, or delete ANY of them, including their own — this is
    // deliberately one-directional, like dropping a letter in a mailbox slot. Robin reads these
    // directly in the Firebase Console (Console access isn't bound by these rules at all). Basic
    // shape validation only: a non-empty, size-capped message and a known kind, so this can't be
    // used to dump arbitrary large blobs.
    // ---------------------------------------------------------------------
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.kind in ['feedback', 'error']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 6000;
      allow read, update, delete: if false;
    }
  }
}
