rules_version = '2';

// Firestore Security Rules for cricket-scorer.
//
// This file is not auto-deployed — paste it into Firebase Console → Firestore Database → Rules
// → Publish. Keeping it in the repo is so the actual access-control model has a diff history,
// instead of living only as tribal knowledge in the console.
//
// ---- The trust model in one paragraph ----
// This app has three tiers of data, each with a different capability:
//   1. /users/{uid}/...        — private to one signed-in Google account.
//   2. /sharedMatches/{code}   — a match code is a bearer capability for FULL scoring access.
//                                 Anyone who has the code (signed in or not) can read AND write it.
//   3. /liveViews/{code}       — a view code is a bearer capability for READ-ONLY access. A
//                                 DIFFERENT collection from #2, keyed by a DIFFERENT random code,
//                                 so a view code can never be used to gain scoring access no
//                                 matter what a viewer does with it — there is no document at
//                                 that code inside /sharedMatches for it to match.
// Clubs add a fourth tier: shared-but-not-public team rosters and tournaments, gated by Google
// account membership rather than a bearer code, because unlike a single match you actually want
// to know (and be able to revoke) who's in a club.
// Federations add a fifth, much thinner tier on top of clubs: a club can opt into a federation
// (e.g. "DCF") the same way a person joins a club, but a federation grants no membership,
// matches, or roster access of its own — only a read-only name directory (federations/{id}/teams)
// that says "this club has a team called X", so a tournament organizer in one member club can
// pick another member club's team without ever seeing that club's private data.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Personal account data — matches, teams, profile, house rules.
    // Only the signed-in owner can ever read or write their own subtree.
    // ---------------------------------------------------------------------
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------------
    // Full-access co-scoring. Knowledge of the 8-character code IS the credential — this is
    // intentional (it's how a teammate resumes scoring on another phone with no account needed)
    // and is unchanged from before. What changed is that this code is no longer also accepted as
    // a "read-only" link — see /liveViews below.
    // ---------------------------------------------------------------------
    match /sharedMatches/{code} {
      allow read, write: if true;
    }

    // ---------------------------------------------------------------------
    // Read-only live-follow mirror. Same open-by-code trust model as sharedMatches, but it is a
    // SEPARATE collection so a view code and a score code are never interchangeable. The app
    // only ever writes here from the match owner's client (see saveMatch/liveViews mirror write
    // in index.html) and only ever reads here from FollowScreen, which has no scoring controls.
    // ---------------------------------------------------------------------
    match /liveViews/{code} {
      allow read, write: if true;
    }

    // ---------------------------------------------------------------------
    // Clubs — shared team rosters gated by Google-account membership, not a bearer code.
    // ---------------------------------------------------------------------
    match /clubs/{clubId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      allow update: if request.auth != null && (
        // (A) Owner or admin editing general club data (name, federationIds, and so on).
        // Membership, ownership, and the admin list itself must not change via this branch —
        // that's what (A2)/(B)/(C)/(D) are for. Uses get(field, default) throughout because
        // clubs created before the admin-role feature existed have no adminUids field at all —
        // a bare resource.data.adminUids on one of those errors out the whole check rather than
        // reading as empty.
        (
          (request.auth.uid == resource.data.ownerUid || request.auth.uid in resource.data.get('adminUids', [])) &&
          request.resource.data.memberUids == resource.data.memberUids &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.get('adminUids', []) == resource.data.get('adminUids', [])
        )
        ||
        // (A2) Owner promoting or demoting admins. Owner-only — there's no multi-step admin
        // invite flow, so this is the sole path onto/off of adminUids. Every admin must already
        // be a member; you can't hand admin rights to someone outside the club.
        (
          request.auth.uid == resource.data.ownerUid &&
          request.resource.data.memberUids == resource.data.memberUids &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.adminUids.hasOnly(resource.data.memberUids)
        )
        ||
        // (B) Self-join with a valid, unexpired invite code that names THIS club. The code is
        // looked up by its own ID — never queried/listed — exactly like sharedMatches/liveViews.
        // adminUids can't change here — joining never grants admin rights.
        (
          !(request.auth.uid in resource.data.memberUids) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.get('adminUids', []) == resource.data.get('adminUids', []) &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid]) &&
          'joinCodeUsed' in request.resource.data &&
          get(/databases/$(database)/documents/clubJoinCodes/$(request.resource.data.joinCodeUsed)).data.clubId == clubId &&
          get(/databases/$(database)/documents/clubJoinCodes/$(request.resource.data.joinCodeUsed)).data.expiresAt > request.time.toMillis()
        )
        ||
        // (C) Self-leave. Anyone but the owner can remove only themselves — also drops
        // themselves from adminUids, if they were one.
        (
          request.auth.uid in resource.data.memberUids &&
          request.auth.uid != resource.data.ownerUid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid]) &&
          request.resource.data.get('adminUids', []) == resource.data.get('adminUids', []).removeAll([request.auth.uid])
        )
        ||
        // (D) Owner removing someone else, or pruning the list — ownership itself can't change
        // here (that would need an explicit transfer flow, deliberately not built). adminUids
        // must stay a subset of whatever memberUids ends up as, so a removed admin can't linger.
        (
          request.auth.uid == resource.data.ownerUid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.memberUids.hasOnly(resource.data.memberUids) &&
          request.resource.data.get('adminUids', []).hasOnly(request.resource.data.memberUids)
        )
      );

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    match /clubs/{clubId}/teams/{teamId} {
      allow read, write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberUids;
    }

    match /clubs/{clubId}/tournaments/{tournamentId} {
      allow read, write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberUids;
    }

    // ---------------------------------------------------------------------
    // Club invite codes. A code is a single-purpose capability token: any signed-in user can
    // look one up by its exact ID (that's how joining resolves code → clubId), but only the
    // club's owner or an admin can mint or revoke one.
    // ---------------------------------------------------------------------
    match /clubJoinCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.clubId is string
        && (
          request.auth.uid == get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.ownerUid
          || request.auth.uid in get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.get('adminUids', [])
        );

      allow delete: if request.auth != null
        && (
          request.auth.uid == get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data.ownerUid
          || request.auth.uid in get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data.get('adminUids', [])
        );

      allow update: if false; // codes are immutable — rotate by delete + create instead
    }

    // ---------------------------------------------------------------------
    // Federations — a light umbrella tag (e.g. "DCF") that clubs opt into via a join code, same
    // bearer-capability pattern as a club invite. A federation's creator is its permanent admin;
    // they can promote co-admins the same way a club owner promotes club admins. There's no
    // multi-step "invite a person to be a federation admin" flow yet (this app has no user-lookup
    // anywhere), so admin promotion is creator-only rather than admin-can-promote-admin.
    // ---------------------------------------------------------------------
    match /federations/{federationId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if request.auth != null && (
        // (A) Existing admin or the creator editing federation data (rename, kickedClubIds).
        // adminUids and createdBy must not change via this branch — that's what (B)/(C) are for.
        // get(field, default) handles federations from before this field existed.
        (
          (request.auth.uid == resource.data.createdBy || request.auth.uid in resource.data.get('adminUids', [])) &&
          request.resource.data.get('adminUids', []) == resource.data.get('adminUids', []) &&
          request.resource.data.createdBy == resource.data.createdBy
        )
        ||
        // (B) Creator promoting or demoting admins. Creator-only, and the name can't change in
        // the same write — keeps each write single-purpose, same style as the clubs rule above.
        (
          request.auth.uid == resource.data.createdBy &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.name == resource.data.name
        )
        ||
        // (C) Self-redeeming an admin invite code addressed to MY signed-in email — see
        // inviteFederationAdminByEmail/redeemFederationAdminInvite in index.html. Only adds
        // the caller to adminUids; name/createdBy locked, and the code must actually name this
        // federation and this exact email.
        (
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.adminUids == resource.data.get('adminUids', []).concat([request.auth.uid]) &&
          'adminInviteCodeUsed' in request.resource.data &&
          get(/databases/$(database)/documents/federationAdminInviteCodes/$(request.resource.data.adminInviteCodeUsed)).data.federationId == federationId &&
          get(/databases/$(database)/documents/federationAdminInviteCodes/$(request.resource.data.adminInviteCodeUsed)).data.email == request.auth.token.email.lower()
        )
      );

      allow delete: if false;
    }

    match /federationJoinCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.federationId is string;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      allow update: if false;
    }

    // An admin invite is addressed to one specific email, unlike every other bearer code in this
    // app — anyone can look it up by ID (same as clubJoinCodes/federationJoinCodes), but it only
    // becomes an actual admin grant if the redeemer's own signed-in email matches (enforced in
    // the federations/{id} update rule, branch C, not here — this collection only controls who
    // can mint/revoke the invite itself).
    match /federationAdminInviteCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.federationId is string
        && request.resource.data.email is string
        && (
          request.auth.uid == get(/databases/$(database)/documents/federations/$(request.resource.data.federationId)).data.createdBy
          || request.auth.uid in get(/databases/$(database)/documents/federations/$(request.resource.data.federationId)).data.get('adminUids', [])
        );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      allow update: if false;
    }

    // A directory entry publishes one club's team name as visible to every OTHER club sharing
    // this same federation. Read is open to any signed-in user — this is intentionally a name
    // directory, not a security boundary, exactly like what a federation join code itself grants
    // (see joinFederationWithCode in index.html). A write is only valid if the writer is a
    // member of the club being published AND that club currently lists this federation in its
    // own federationIds AND the federation hasn't blocklisted that club (kickedClubIds — see
    // kickClubFromFederation in index.html for why a "kick" lives here rather than as a write to
    // the target club's own document, which this app never allows). Existing stale entries are
    // cleaned up client-side by leaveFederation()/kickClubFromFederation() rather than by this
    // rule; losing federation affiliation or club membership just blocks further writes.
    match /federations/{federationId}/teams/{entryId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.clubId is string
        && request.auth.uid in get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.memberUids
        && federationId in get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.get('federationIds', [])
        && !(request.resource.data.clubId in get(/databases/$(database)/documents/federations/$(federationId)).data.get('kickedClubIds', []));

      allow delete: if request.auth != null
        && (
          request.auth.uid in get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data.memberUids
          || request.auth.uid == get(/databases/$(database)/documents/federations/$(federationId)).data.createdBy
          || request.auth.uid in get(/databases/$(database)/documents/federations/$(federationId)).data.get('adminUids', [])
        );
    }
  }
}
